@model RealEstateWebApp.Models.Property
@{
    ViewData["Title"] = "تفاصيل العقار";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تفاصيل العقار | SYRELIS</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <style>
        :root {
            --dark: #192e43;
            --gold: #d4af37;
            --gray: #51596a;
            --white: #ffffff;
            --gold-light: #f4e5c2;
            --border: #e8e4dc;
            --bg-light: #f8f9fa;
            --shadow: 0 4px 16px rgba(11, 19, 32, 0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(126deg, rgba(11, 19, 32, 0.85), rgb(11 19 32 / 62%)), url(https://images.unsplash.com/photo-1600585154526-990dced4db0d?q=80&w=2070&auto=format);
            background-size: cover;
            background-position: center;
            font-family: "Tajawal", sans-serif;
            color: var(--gold);
            line-height: 1.6;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
        }

        /* ====== نافبار ====== */
        .navbar {
            background: rgba(11, 19, 32, 0.96);
            padding: 0 1rem;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(212, 175, 55, 0.4);
            justify-content: space-evenly;
            box-shadow: 0px 15px 30px -10px rgb(23, 22, 70);
            position: sticky;
            top: 0;
            z-index: 2000;
            flex-wrap: wrap;
            gap: 10px;
        }

        .logo {
            width: 6%;
            margin-top: 8px;
            margin-bottom: 8px;
            min-width: 50px;
            flex-shrink: 0;
        }

        .nav-links {
            padding: 0 18rem;
            display: flex;
            gap: 70px;
            list-style: none;
            flex-wrap: wrap;
            justify-content: center;
        }

            .nav-links a {
                color: #f2efea;
                text-decoration: none;
                font-weight: 600;
                font-size: 1rem;
                transition: 0.3s;
                white-space: nowrap;
            }

                .nav-links a:hover {
                    color: #d4af37;
                }

        /* ====== كارد التفاصيل ====== */
        .card {
            max-width: 100%;
            background: var(--white);
            border-radius: 20px;
            padding: 28px;
            margin-top: 50px;
            margin-bottom: 61px;
        }

        .detail-header-card {
            background: linear-gradient(135deg, #f8f9fa, #ffffff);
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 25px;
            border: 2px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .detail-header-info h2 {
            font-size: 1.8rem;
            color: var(--dark);
            margin-bottom: 5px;
        }

        .detail-header-info .detail-type-badge {
            background: var(--dark);
            color: var(--gold);
            padding: 6px 20px;
            border-radius: 25px;
            font-weight: 700;
            font-size: 1rem;
            display: inline-block;
        }

        .detail-header-price {
            text-align: left;
        }

            .detail-header-price .price-label {
                font-size: 0.85rem;
                color: var(--gray);
            }

            .detail-header-price .price-value {
                font-size: 2rem;
                font-weight: 900;
                color: var(--gold);
                font-family: 'Cinzel', serif;
            }

            .detail-header-price .price-currency {
                font-size: 1rem;
                color: var(--gray);
            }

        /* ====== الإحصائيات السريعة ====== */
        .detail-quick-stats {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 15px;
            padding: 20px;
            background: var(--bg-light);
            border-radius: 16px;
            border: 2px solid var(--border);
            margin-bottom: 25px;
        }

        .detail-stat-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px;
            background: white;
            border-radius: 14px;
            border: 2px solid var(--border);
            transition: var(--transition);
        }

        .detail-stat-icon {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, var(--dark) 0%, #1a3355 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fad765;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .detail-stat-info .detail-stat-value {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--dark);
            line-height: 1;
        }

        .detail-stat-info .detail-stat-label {
            font-size: 0.8rem;
            color: var(--gray);
            margin-top: 4px;
            font-weight: 500;
        }

        /* ====== الأقسام ====== */
        .detail-section {
            margin-bottom: 30px;
            padding-bottom: 30px;
            border-bottom: 2px solid var(--border);
        }

            .detail-section:last-child {
                border-bottom: none;
                margin-bottom: 0;
                padding-bottom: 0;
            }

        .detail-section-title {
            margin-top: 26px;
            color: #192e43;
            font-size: 1.6rem;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .detail-section-title i {
                color: #ffffff;
                font-size: 1.3rem;
                background: #192e43;
                width: 48px;
                height: 48px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                box-shadow: 2px 3px 0px rgb(103 103 103 / 45%);
            }

            .detail-section-title::after {
                content: "";
                flex: 1;
                height: 3px;
                background: linear-gradient(to left, transparent, var(--gold-light), var(--gold));
                margin-right: 15px;
                border-radius: 2px;
            }

        .detail-description-text {
            font-size: 1.1rem;
            color: #0e0e0e;
            line-height: 1.9;
            white-space: pre-wrap;
            padding: 18px;
            background: var(--bg-light);
            border-radius: 14px;
            border-right: 4px solid var(--gold);
        }

        /* ====== معرض الصور ====== */
        .detail-gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 14px;
        }

        .detail-gallery-item {
            position: relative;
            aspect-ratio: 4/3;
            border-radius: 14px;
            overflow: hidden;
            cursor: pointer;
            border: 3px solid var(--border);
            transition: var(--transition);
        }

            .detail-gallery-item:hover {
                transform: scale(1.05);
                border-color: var(--gold);
                box-shadow: 0 15px 35px rgba(212, 175, 55, 0.4);
                z-index: 2;
            }

            .detail-gallery-item img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s ease;
            }

            .detail-gallery-item:hover img {
                transform: scale(1.1);
            }

            .detail-gallery-item .detail-zoom-icon {
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                width: 45px;
                height: 45px;
                background: rgba(212, 175, 55, 0.95);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--dark);
                opacity: 0;
                transition: var(--transition);
                font-size: 1.2rem;
            }

            .detail-gallery-item:hover .detail-zoom-icon {
                opacity: 1;
                transform: translate(-50%, -50%) scale(1.1);
            }

        /* ====== المرافق ====== */
        .detail-features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 12px;
        }

        .detail-feature-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 13px 18px;
            background: linear-gradient(135deg, var(--bg-light) 0%, #ffffff 100%);
            border: 2px solid var(--border);
            border-radius: 12px;
            font-weight: 700;
            color: var(--dark);
            transition: var(--transition);
            font-size: 0.9rem;
        }

            .detail-feature-item i {
                color: #fad765;
                font-size: 1.4rem;
                width: 22px;
                text-align: center;
                transition: var(--transition);
            }

        /* ====== الموقع والخريطة ====== */
        .detail-location-wrapper {
            display: grid;
            grid-template-columns: 1fr 350px;
            gap: 25px;
            align-items: start;
        }

        .detail-static-map {
            width: 100%;
            height: 330px;
            border-radius: 18px;
            overflow: hidden;
            border: 3px solid #d4af37;
            transition: var(--transition);
        }

            .detail-static-map:hover {
                border-color: var(--gold);
                box-shadow: 0 15px 40px rgba(212, 175, 55, 0.3);
            }

        #detailStaticMap {
            width: 100%;
            height: 100%;
        }

        .detail-location-info {
            background: linear-gradient(135deg, var(--bg-light) 0%, #ffffff 100%);
            padding: 25px;
            border-radius: 18px;
            border: 2px solid var(--border);
            box-shadow: var(--shadow);
        }

            .detail-location-info h4 {
                color: var(--dark);
                font-size: 1.15rem;
                margin-bottom: 18px;
                display: flex;
                align-items: center;
                gap: 10px;
                font-weight: 800;
            }

                .detail-location-info h4 i {
                    color: #fad765;
                    font-size: 1.3rem;
                }

        .detail-location-detail {
            text-align: start;
            display: flex;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid var(--border);
            color: var(--gray);
            font-size: 0.9rem;
            transition: var(--transition);
            justify-content: flex-start;
            align-items: flex-start;
        }

            .detail-location-detail:last-child {
                border-bottom: none;
            }

            .detail-location-detail i {
                color: #fad765;
                margin-top: 4px;
                width: 20px;
                font-size: 1.1rem;
            }

            .detail-location-detail strong {
                text-align: start;
                color: var(--dark);
                display: block;
                font-size: 0.95rem;
                margin-bottom: 3px;
                font-weight: 700;
            }

        /* ====== زر العودة ====== */
        .btn {
            padding: 12px 26px;
            border: none;
            border-radius: 10px;
            font-family: "Tajawal", sans-serif;
            font-size: 0.98rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            text-decoration: none;
        }

        .btn-primary {
            background: var(--dark);
            color: #ffffff;
            box-shadow: -1px 2px 9px rgb(11 19 32 / 73%);
        }

            .btn-primary:hover {
                background: #ffffff;
                color: #1a3250;
            }

        .btn-secondary {
            border: 1px solid #1a3250;
            background: #1a314d;
            color: #ffffff;
            border-radius: 10px;
            padding: 10px 20px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
        }

            .btn-secondary:hover {
                background: #ffffff;
                color: #1a3250;
            }

        /* ====== Responsive ====== */
        @@media (max-width: 992px) {
            .detail-location-wrapper {
                grid-template-columns: 1fr;
            }

            .nav-links {
                padding: 0 2rem;
                gap: 25px;
            }
        }

        @@media (max-width: 768px) {
            .detail-quick-stats {
                grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
                padding: 15px;
            }

            .detail-header-card {
                flex-direction: column;
                align-items: flex-start;
            }

            .detail-header-price {
                text-align: right;
                width: 100%;
            }

            .nav-links {
                padding: 0;
                gap: 15px;
                flex-wrap: wrap;
            }

                .nav-links a {
                    font-size: 0.8rem;
                }

            .container {
                padding: 0.8rem;
            }

            .detail-gallery-grid {
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            }
        }
    </style>
</head>
<body>

    <!-- ====== نافبار ====== -->
    <nav class="navbar">
        <img class="logo" src="~/hero.png" alt="Logo">
        <ul class="nav-links">
            <li><a href="/">الرئيسية</a></li>
            <li><a href="/Properties/Create">أعلن عن عقارك</a></li>
            <li><a href="#">ابحث عن عقارك</a></li>
            <li><a href="/Properties/MyProperties">عقاراتي</a></li>
            <li><a href="#">تواصل معنا</a></li>
        </ul>
    </nav>

    <div class="container">
        <div class="card">

            <!-- ====== الهيدر ====== -->
            <div class="detail-header-card">
                <div class="detail-header-info">
                    <h2>@Model.Title</h2>
                    <span class="detail-type-badge">@(Model.PropertyType?.NameAr ?? "عقار")</span>
                    <span class="detail-type-badge" style="background:var(--gold);color:var(--dark);margin-right:10px;">@Model.Status</span>
                </div>
                <div class="detail-header-price">
                    <div class="price-label">السعر</div>
                    <div class="price-value">@Model.Price.ToString("N0") <span class="price-currency">@Model.PriceCurrency</span></div>
                </div>
            </div>

            <!-- ====== الإحصائيات السريعة ====== -->
            <div class="detail-quick-stats">
                @if (!string.IsNullOrEmpty(Model.Code))
                {
                    var propNumber = Model.Code.Split('-').LastOrDefault() ?? "0";
                    <div class="detail-stat-item">
                        <div class="detail-stat-icon"><i class="fa-solid fa-hashtag"></i></div>
                        <div class="detail-stat-info">
                            <div class="detail-stat-value">@propNumber</div>
                            <div class="detail-stat-label">رقم المحضر</div>
                        </div>
                    </div>
                }
                <div class="detail-stat-item">
                    <div class="detail-stat-icon"><i class="fa-solid fa-ruler-combined"></i></div>
                    <div class="detail-stat-info">
                        <div class="detail-stat-value">@Model.Area م²</div>
                        <div class="detail-stat-label">المساحة</div>
                    </div>
                </div>
                @if (Model.Rooms > 0)
                {
                    <div class="detail-stat-item">
                        <div class="detail-stat-icon"><i class="fa-solid fa-bed"></i></div>
                        <div class="detail-stat-info">
                            <div class="detail-stat-value">@Model.Rooms</div>
                            <div class="detail-stat-label">عدد الغرف</div>
                        </div>
                    </div>
                }
                @if (Model.Bathrooms > 0)
                {
                    <div class="detail-stat-item">
                        <div class="detail-stat-icon"><i class="fa-solid fa-bath"></i></div>
                        <div class="detail-stat-info">
                            <div class="detail-stat-value">@Model.Bathrooms</div>
                            <div class="detail-stat-label">الحمامات</div>
                        </div>
                    </div>
                }
                @if (Model.Floor.HasValue)
                {
                    <div class="detail-stat-item">
                        <div class="detail-stat-icon"><i class="fa-solid fa-layer-group"></i></div>
                        <div class="detail-stat-info">
                            <div class="detail-stat-value">@Model.Floor</div>
                            <div class="detail-stat-label">الطابق</div>
                        </div>
                    </div>
                }
                @if (Model.AvailableFrom.HasValue)
                {
                    <div class="detail-stat-item">
                        <div class="detail-stat-icon"><i class="fa-solid fa-calendar-check"></i></div>
                        <div class="detail-stat-info">
                            <div class="detail-stat-value">@Model.AvailableFrom.Value.ToString("yyyy/MM/dd")</div>
                            <div class="detail-stat-label">متاح من</div>
                        </div>
                    </div>
                }
            </div>

            <!-- ====== الوصف ====== -->
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="detail-section">
                    <h3 class="detail-section-title"><i class="fa-solid fa-align-right"></i> وصف العقار</h3>
                    <div class="detail-description-text">@Model.Description</div>
                </div>
            }

            <!-- ====== معرض الصور ====== -->
            @if (Model.Images != null && Model.Images.Any())
            {
                <div class="detail-section">
                    <h3 class="detail-section-title"><i class="fa-solid fa-images"></i> معرض الصور (@Model.Images.Count)</h3>
                    <div class="detail-gallery-grid">
                        @foreach (var img in Model.Images)
                        {
                            <div class="detail-gallery-item" onclick="openImageLightbox('@img.ImageUrl')">
                                <img src="@img.ImageUrl" alt="صورة العقار" />
                                <div class="detail-zoom-icon"><i class="fa-solid fa-magnifying-glass-plus"></i></div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- ====== المرافق ====== -->
            @if (Model.Features != null && Model.Features.Any())
            {
                <div class="detail-section">
                    <h3 class="detail-section-title"><i class="fa-solid fa-check-double"></i> المرافق والخدمات</h3>
                    <div class="detail-features-grid">
                        @foreach (var feature in Model.Features)
                        {
                            <div class="detail-feature-item">
                                <i class="fa-solid @(feature.IconClass ?? "fa-check")"></i>
                                <span>@feature.NameAr</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- ====== الموقع ====== -->
            <div class="detail-section">
                <h3 class="detail-section-title"><i class="fa-solid fa-map-location-dot"></i> الموقع</h3>
                <div class="detail-location-wrapper">
                    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                    {
                        <div class="detail-static-map">
                            <div id="detailStaticMap"></div>
                        </div>
                    }
                    <div class="detail-location-info">
                        <h4><i class="fa-solid fa-circle-info"></i> تفاصيل الموقع</h4>
                        @if (!string.IsNullOrEmpty(Model.City?.NameAr))
                        {
                            <div class="detail-location-detail">
                                <i class="fa-solid fa-city"></i>
                                <div><strong>المدينة</strong>@Model.City.NameAr</div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Neighborhood))
                        {
                            <div class="detail-location-detail">
                                <i class="fa-solid fa-map-pin"></i>
                                <div><strong>الحي</strong>@Model.Neighborhood</div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Address))
                        {
                            <div class="detail-location-detail">
                                <i class="fa-solid fa-road"></i>
                                <div><strong>الشارع</strong>@Model.Address</div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.DetailedLocation))
                        {
                            <div class="detail-location-detail">
                                <i class="fa-solid fa-location-crosshairs"></i>
                                <div><strong>الموقع التفصيلي</strong>@Model.DetailedLocation</div>
                            </div>
                        }
                        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                        {
                            <div class="detail-location-detail">
                                <i class="fa-solid fa-globe"></i>
                                <div>
                                    <strong>الإحداثيات</strong>
                                    @Model.Latitude.Value.ToString("F5"), @Model.Longitude.Value.ToString("F5")
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ====== زر العودة ====== -->
            <div style="text-align:center; margin-top:30px;">
                <a href="/Properties/MyProperties" class="btn btn-primary">
                    <i class="fa-solid fa-arrow-right"></i> العودة إلى عقاراتي
                </a>
            </div>

        </div>
    </div>

    <!-- ====== سكربتات ====== -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // ====== عرض الصور بتكبير ======
        function openImageLightbox(src) {
            var lightbox = document.createElement('div');
            lightbox.style.cssText = 'position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.95); z-index:999999; display:flex; align-items:center; justify-content:center; padding:20px; cursor:pointer;';
            lightbox.innerHTML = `
                <img src="${src}" style="max-width:90%; max-height:90vh; border-radius:16px; box-shadow:0 25px 80px rgba(0,0,0,0.8);">
                <button style="position:absolute; top:25px; right:25px; width:50px; height:50px; background:#d4af37; border:none; border-radius:50%; cursor:pointer; font-size:1.4rem; color:#192e43; transition:all 0.3s;" onclick="this.parentElement.remove()">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            `;
            lightbox.onclick = function(e) { if (e.target === this) this.remove(); };
            document.body.appendChild(lightbox);
            document.body.style.overflow = 'hidden';
            lightbox.addEventListener('remove', function() { document.body.style.overflow = ''; });
        }

        // ====== الخريطة ======
        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
        {
                <text>
                document.addEventListener('DOMContentLoaded', function() {
                    var mapContainer = document.getElementById('detailStaticMap');
                    if (!mapContainer) return;

                    var map = L.map('detailStaticMap', {
                        center: [@Model.Latitude.Value.ToString("F6"), @Model.Longitude.Value.ToString("F6")],
                        zoom: 15,
                        dragging: false,
                        scrollWheelZoom: false,
                        touchZoom: false,
                        doubleClickZoom: false,
                        boxZoom: false,
                        keyboard: false,
                        zoomControl: false,
                        attributionControl: false
                    });

                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        maxZoom: 19
                    }).addTo(map);

                    var pegmanSVG = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 23 38" width="44" height="44">
