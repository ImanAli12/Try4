                                        <p>يفضل صورة واضحة وذات جودة عالية</p>
                                        <input type="file" id="mainImg" name="MainImage" accept="image/*" hidden onchange="handleMainImg(this)" required />
                                    </div>
                                    <div id="mainImgPrev" class="uploaded-images"></div>
                                    <span asp-validation-for="MainImage" class="error-message" id="mainImgError"></span>
                                </div>

                                <div class="form-group" style="margin-top: 22px">
                                    <label>صور إضافية</label>
                                    <div class="upload-box" onclick="document.getElementById('propImgs').click()">
                                        <i class="fa-solid fa-images"></i>
                                        <h4>اضغط لرفع صور إضافية</h4>
                                        <p>يمكن اختيار أكثر من صورة</p>
                                        <input type="file" id="propImgs" name="AdditionalImages" accept="image/*" multiple hidden onchange="handlePropImgs(this)" />
                                    </div>
                                    <div id="propImgsPrev" class="uploaded-images"></div>
                                </div>
                            </div>

                            <!-- ====== الخطوة 3 ====== -->
                            <div class="form-step hidden" data-step="3">
                                <div class="form-grid">
                                    <div class="form-group">
                                        <label>المدينة <span class="req">*</span></label>
                                        <select asp-for="CityId" class="form-control" id="citySelect" onchange="onCityChange(this.value)" required>
                                            <option value="" disabled selected hidden>اختر المدينة</option>
                                            @if (Model.Cities != null)
                                            {
                                                foreach (var city in Model.Cities)
                                                {
                                                    <option value="@city.Id">@city.NameAr</option>
                                                }
                                            }
                                        </select>
                                        <span asp-validation-for="CityId" class="error-message"></span>
                                    </div>

                                    <div class="form-group">
                                        <label>الحي <span class="req">*</span></label>
                                        <input asp-for="Neighborhood" class="form-control" placeholder="اسم الحي" required />
                                        <span asp-validation-for="Neighborhood" class="error-message"></span>
                                    </div>

                                    <div class="form-group full">
                                        <label>الشارع</label>
                                        <input asp-for="Address" class="form-control" placeholder="اسم الشارع" />
                                    </div>

                                    <div class="form-group full">
                                        <label>ادخل الموقع التفصيلي للعقار <span class="req">*</span></label>
                                        <textarea asp-for="DetailedLocation" class="form-control" placeholder="أدخل موقع العقار بالتفصيل..." required></textarea>
                                        <span asp-validation-for="DetailedLocation" class="error-message"></span>
                                    </div>

                                    <div class="form-group full map-section">
                                        <label>تحديد الموقع <span class="req">*</span></label>
                                        <p class="map-instructions">اسحب الرجل الأصفر وحدد موقعك بدقة</p>
                                        <div class="map-wrapper" id="mapWrapper">
                                            <div id="map"></div>
                                            <div class="control-container">
                                                <button type="button" class="map-btn active" onclick="setLayer('map')" id="btnMap">
                                                    <svg viewBox="0 0 24 24" width="16" height="16"><path d="M20.5 3l-.16.03L15 5.1 9 3 3.36 4.9c-.21.07-.36.25-.36.48V20.5c0 .28.22.5.5.5l.16-.03L9 18.9l6 2.1 5.64-1.9c.21-.07.36-.25.36-.48V3.5c0-.28-.22-.5-.5-.5zM15 19l-6-2.11V5l6 2.11V19z" /></svg>
                                                    خريطة
                                                </button>
                                                <button type="button" class="map-btn" onclick="setLayer('satellite')" id="btnSat">
                                                    <svg viewBox="0 0 24 24" width="16" height="16"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" /></svg>
                                                    قمر صناعي
                                                </button>
                                            </div>
                                            <button type="button" class="fullscreen-btn" onclick="toggleFullscreen()" title="ملء الشاشة">
                                                <svg viewBox="0 0 24 24" width="20" height="20"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z" /></svg>
                                            </button>
                                            <button type="button" class="pegman-btn" id="pegmanBtn" title="اسحب لتحديد الموقع">
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 23 38" width="34" height="34"><path d="M16.6 38.1h-5.5l-.2-2.9-.2 2.9H5.2L5 25.3l-.8 2a1.53 1.53 0 01-1.9.9l-1.2-.4a1.58 1.58 0 01-1-1.9v-.1c.3-.9 3.1-11.2 3.1-11.2a2.66 2.66 0 012.3-2l.6-.5a6.93 6.93 0 014.7-12 6.8 6.8 0 014.9 2 7 7 0 012 4.9 6.65 6.65 0 01-2.2 5l.7.5a2.78 2.78 0 012.4 2s2.9 11.2 2.9 11.3a1.53 1.53 0 01-.9 1.9l-1.3.4a1.63 1.63 0 01-1.9-.9l-.7-1.8z" fill="#333" opacity=".7" /><path d="m5.9 13.6 1.1-.9h7.8l1.2.9" fill="#ce592c" /><ellipse cx="10.9" cy="13.1" rx="2.7" ry=".3" fill="#ce592c" opacity=".5" /><path d="m20.6 26.1-2.9-11.3a1.71 1.71 0 00-1.6-1.2H5.7a1.69 1.69 0 00-1.5 1.3L1.1 26.2a.61.61 0 00.3.7l1.1.4a.61.61 0 00.7-.3l2.7-6.7.2 16.8h3.6l.6-9.3a.47.47 0 01.44-.5h.06c.4 0 .4.2.5.5l.6 9.3h3.6l.2-16.8 2.5 6.6a.52.52 0 00.66.31l1.2-.4a.57.57 0 00.5-.7Z" fill="#fdbf2d" /><path d="m7 13.6 3.9 6.7 3.9-6.7" fill="#cf572e" opacity=".6" /><circle cx="10.9" cy="7" r="5.9" fill="#fdbf2d" /></svg>
                                            </button>
                                            <div id="dragIcon" aria-hidden="true" style="position: fixed; display: none; z-index: 9999; pointer-events: none;">
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 23 38" width="52" height="52"><path d="M16.6 38.1h-5.5l-.2-2.9-.2 2.9H5.2L5 25.3l-.8 2a1.53 1.53 0 01-1.9.9l-1.2-.4a1.58 1.58 0 01-1-1.9v-.1c.3-.9 3.1-11.2 3.1-11.2a2.66 2.66 0 012.3-2l.6-.5a6.93 6.93 0 014.7-12 6.8 6.8 0 014.9 2 7 7 0 012 4.9 6.65 6.65 0 01-2.2 5l.7.5a2.78 2.78 0 012.4 2s2.9 11.2 2.9 11.3a1.53 1.53 0 01-.9 1.9l-1.3.4a1.63 1.63 0 01-1.9-.9l-.7-1.8z" fill="#333" opacity=".7" /><path d="m5.9 13.6 1.1-.9h7.8l1.2.9" fill="#ce592c" /><ellipse cx="10.9" cy="13.1" rx="2.7" ry=".3" fill="#ce592c" opacity=".5" /><path d="m20.6 26.1-2.9-11.3a1.71 1.71 0 00-1.6-1.2H5.7a1.69 1.69 0 00-1.5 1.3L1.1 26.2a.61.61 0 00.3.7l1.1.4a.61.61 0 00.7-.3l2.7-6.7.2 16.8h3.6l.6-9.3a.47.47 0 01.44-.5h.06c.4 0 .4.2.5.5l.6 9.3h3.6l.2-16.8 2.5 6.6a.52.52 0 00.66.31l1.2-.4a.57.57 0 00.5-.7Z" fill="#fdbf2d" /><path d="m7 13.6 3.9 6.7 3.9-6.7" fill="#cf572e" opacity=".6" /><circle cx="10.9" cy="7" r="5.9" fill="#fdbf2d" /></svg>
                                            </div>
                                        </div>

                                        <div class="hawya">
                                            <div class="coords-box">
                                                <div class="coord-item">
                                                    <label><i class="fa-solid fa-location-dot"></i> خط العرض</label>
                                                    <span id="latDisplay">--</span>
                                                </div>
                                                <div class="coord-item">
                                                    <label><i class="fa-solid fa-location-dot"></i> خط الطول</label>
                                                    <span id="lngDisplay">--</span>
                                                </div>
                                            </div>
                                            <div class="restart">
                                                <button type="button" class="btn-reset-location" onclick="resetLocation()">
                                                    <i class="fa-solid fa-rotate-right"></i>
                                                    <span>إعادة تعيين</span>
                                                </button>
                                            </div>
                                        </div>

                                        <input asp-for="Latitude" type="hidden" id="inputLat" required />
                                        <input asp-for="Longitude" type="hidden" id="inputLng" required />
                                        <span asp-validation-for="Latitude" class="error-message" id="mapError"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- ====== الخطوة 4 ====== -->
                            <div class="form-step hidden" data-step="4">
                                <div class="form-grid">
                                    <div class="form-group">
                                        <label>رقم المحضر <span class="req">*</span></label>
                                        <input asp-for="PropertyNumber" type="number" class="form-control" placeholder="أدخل رقم المحضر" required min="1" />
                                        <span asp-validation-for="PropertyNumber" class="error-message"></span>
                                    </div>

                                    <div class="form-group">
                                        <label>المساحة (م²) <span class="req">*</span></label>
                                        <input asp-for="Area" type="number" class="form-control" placeholder="المساحة" required min="1" />
                                        <span asp-validation-for="Area" class="error-message"></span>
                                    </div>

                                    <div class="form-group">
                                        <label>عدد الغرف</label>
                                        <input asp-for="Rooms" type="number" class="form-control" placeholder="الغرف" min="0" />
                                    </div>

                                    <div class="form-group">
                                        <label>عدد الحمامات</label>
                                        <input asp-for="Bathrooms" type="number" class="form-control" placeholder="الحمامات" min="0" />
                                    </div>

                                    <div class="form-group">
                                        <label>رقم الطابق</label>
                                        <input asp-for="Floor" type="number" class="form-control" placeholder="رقم الطابق" min="-2" />
                                    </div>

                                    <div class="form-group">
                                        <label>عدد الطوابق</label>
                                        <input asp-for="TotalFloors" type="number" class="form-control" placeholder="إجمالي الطوابق" min="0" />
                                    </div>

                                    <div class="form-group">
                                        <label>متاح من تاريخ <span class="req">*</span></label>
                                        <input asp-for="AvailableFrom" type="date" class="form-control" id="available_from" required />
                                        <span asp-validation-for="AvailableFrom" class="error-message"></span>
                                    </div>

                                    <div class="form-group">
                                        <label>رقم الاتصال <span class="req">*</span></label>
                                        <input asp-for="AdvertiserPhone" type="tel" class="form-control" placeholder="09XXXXXXXX" required maxlength="10" />
                                        <span asp-validation-for="AdvertiserPhone" class="error-message"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- ====== الخطوة 5 ====== -->
                            <div class="form-step hidden" data-step="5">
                                <div class="form-group">
                                    <label>المرافق</label>
                                    <div class="amenities-grid">
                                        @if (Model.Features != null)
                                        {
                                            foreach (var feature in Model.Features)
                                            {
                                                <label class="amenity-item">
                                                    <input type="checkbox" name="FeatureIds" value="@feature.Id" />
                                                    <i class="fa-solid @(feature.IconClass ?? "fa-check")"></i> @feature.NameAr
                                                </label>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- ====== أزرار التنقل ====== -->
                            <div class="form-actions">
                                <div class="btn-group">
                                    <button type="button" id="prevBtn" onclick="changeStep(-1)" class="btn btn-secondary" style="display: none">
                                        <i class="fa-solid fa-arrow-right"></i> السابق
                                    </button>
                                </div>
                                <div class="btn-group">
                                    <button type="button" id="nextBtn" onclick="changeStep(1)" class="btn btn-primary">
                                        التالي <i class="fa-solid fa-arrow-left"></i>
                                    </button>
                                    <button type="submit" id="pubBtn" class="btn btn-primary" style="display: none">
                                        ✓ نشر العقار
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ====== Scripts ====== -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // ====== المتغيرات العامة ======
        let currentStep = 1;
        let map, currentMarker;
        let selectedCityLat = 33.5138;
        let selectedCityLng = 36.2765;

        // ====== إحداثيات المدن من قاعدة البيانات ======
        var syriaCities = {
            @if (Model.Cities != null)
            {
                    foreach (var city in Model.Cities)
                    {
                            <text>"@city.NameAr": { lat: 33.5, lng: 36.3, zoom: 13 },</text>
                    }
            }
        };

        // ====== دوال الخريطة ======
        function initMap(cityId) {
            console.log("🗺️ بدء تهيئة الخريطة...");

            if (map) {
                map.remove();
                map = null;
            }

            var mapElement = document.getElementById("map");
            if (!mapElement) {
                console.error("❌ عنصر #map غير موجود في الصفحة!");
                return;
            }

            var citySelect = document.getElementById('citySelect');
            var cityName = citySelect?.selectedOptions[0]?.text || 'دمشق';
            var defaultCoords = { lat: 33.5138, lng: 36.2765, zoom: 13 };
            var c = syriaCities[cityName] || defaultCoords;

            console.log("📍 المدينة:", cityName, "الإحداثيات:", c);

            try {
                map = L.map("map", {
                    zoomControl: false,
                    dragging: true,
                    minZoom: 8,
                    maxZoom: 19
                }).setView([c.lat || 33.5138, c.lng || 36.2765], c.zoom || 13);

                L.control.zoom({ position: "topright" }).addTo(map);

                var baseLayer = L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                    maxZoom: 19,
                    attribution: '© OpenStreetMap'
                }).addTo(map);

                var satelliteLayer = L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}", {
                    maxZoom: 19
                });

                var satelliteLabels = L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}", {
                    maxZoom: 19
                });

                map._baseLayer = baseLayer;
                map._satelliteLayer = satelliteLayer;
                map._satelliteLabels = satelliteLabels;
                map._currentLayer = 'map';

                // إضافة الرجل الأصفر القابل للسحب
                addPegmanToMap();

                setTimeout(function() {
                    map.invalidateSize();
                    console.log("✅ الخريطة جاهزة!");
                }, 500);

            } catch (error) {
                console.error("❌ خطأ في تهيئة الخريطة:", error);
            }
        }

        // ====== إضافة Pegman (الرجل الأصفر) القابل للسحب ======
        function addPegmanToMap() {
            if (!map) return;

            var pegmanIcon = L.divIcon({
                className: 'pegman-marker',
                html: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 23 38" width="44" height="44"><path d="M16.6 38.1h-5.5l-.2-2.9-.2 2.9H5.2L5 25.3l-.8 2a1.53 1.53 0 01-1.9.9l-1.2-.4a1.58 1.58 0 01-1-1.9v-.1c.3-.9 3.1-11.2 3.1-11.2a2.66 2.66 0 012.3-2l.6-.5a6.93 6.93 0 014.7-12 6.8 6.8 0 014.9 2 7 7 0 012 4.9 6.65 6.65 0 01-2.2 5l.7.5a2.78 2.78 0 012.4 2s2.9 11.2 2.9 11.3a1.53 1.53 0 01-.9 1.9l-1.3.4a1.63 1.63 0 01-1.9-.9l-.7-1.8z" fill="#333" opacity=".7"/><path d="m5.9 13.6 1.1-.9h7.8l1.2.9" fill="#ce592c"/><ellipse cx="10.9" cy="13.1" rx="2.7" ry=".3" fill="#ce592c" opacity=".5"/><path d="m20.6 26.1-2.9-11.3a1.71 1.71 0 00-1.6-1.2H5.7a1.69 1.69 0 00-1.5 1.3L1.1 26.2a.61.61 0 00.3.7l1.1.4a.61.61 0 00.7-.3l2.7-6.7.2 16.8h3.6l.6-9.3a.47.47 0 01.44-.5h.06c.4 0 .4.2.5.5l.6 9.3h3.6l.2-16.8 2.5 6.6a.52.52 0 00.66.31l1.2-.4a.57.57 0 00.5-.7Z" fill="#fdbf2d"/><path d="m7 13.6 3.9 6.7 3.9-6.7" fill="#cf572e" opacity=".6"/><circle cx="10.9" cy="7" r="5.9" fill="#fdbf2d"/></svg>',
                iconSize: [44, 44],
                iconAnchor: [22, 42]
            });

            var center = map.getCenter();
            currentMarker = L.marker([center.lat, center.lng], {
                icon: pegmanIcon,
                draggable: true
            }).addTo(map);

            currentMarker.on('dragend', function(e) {
                var pos = e.target.getLatLng();
                document.getElementById("latDisplay").innerHTML = pos.lat.toFixed(6);
                document.getElementById("lngDisplay").innerHTML = pos.lng.toFixed(6);
                document.getElementById("inputLat").value = pos.lat;
                document.getElementById("inputLng").value = pos.lng;

                var mapErr = document.getElementById("mapError");
                if (mapErr) {
                    mapErr.textContent = "✅ تم تحديد الموقع بنجاح!";
                    mapErr.style.display = "block";
                    mapErr.style.color = "#22c55e";
                    setTimeout(function() {
                        mapErr.style.display = "none";
                    }, 3000);
                }
            });

            map.on('click', function(e) {
                var pos = e.latlng;
                if (currentMarker) {
                    map.removeLayer(currentMarker);
                }
                currentMarker = L.marker([pos.lat, pos.lng], {
                    icon: pegmanIcon,
                    draggable: true
                }).addTo(map);

                document.getElementById("latDisplay").innerHTML = pos.lat.toFixed(6);
                document.getElementById("lngDisplay").innerHTML = pos.lng.toFixed(6);
                document.getElementById("inputLat").value = pos.lat;
                document.getElementById("inputLng").value = pos.lng;

                var mapErr = document.getElementById("mapError");
                if (mapErr) {
                    mapErr.textContent = "✅ تم تحديد الموقع بنجاح!";
                    mapErr.style.display = "block";
                    mapErr.style.color = "#22c55e";
                    setTimeout(function() {
                        mapErr.style.display = "none";
                    }, 3000);
                }

                currentMarker.on('dragend', function(ev) {
                    var newPos = ev.target.getLatLng();
                    document.getElementById("latDisplay").innerHTML = newPos.lat.toFixed(6);
                    document.getElementById("lngDisplay").innerHTML = newPos.lng.toFixed(6);
                    document.getElementById("inputLat").value = newPos.lat;
                    document.getElementById("inputLng").value = newPos.lng;
                });
            });
        }

        // ====== إدخال خط الطول والعرض يدوياً ======
        function updateLocationFromInputs() {
            var lat = document.getElementById("inputLat").value;
            var lng = document.getElementById("inputLng").value;

            if (lat && lng) {
                var latNum = parseFloat(lat);
                var lngNum = parseFloat(lng);

                if (!isNaN(latNum) && !isNaN(lngNum)) {
                    document.getElementById("latDisplay").innerHTML = latNum.toFixed(6);
                    document.getElementById("lngDisplay").innerHTML = lngNum.toFixed(6);

                    if (currentMarker) {
                        map.removeLayer(currentMarker);
                    }

                    var pegmanIcon = L.divIcon({
                        className: 'pegman-marker',
                        html: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 23 38" width="44" height="44"><path d="M16.6 38.1h-5.5l-.2-2.9-.2 2.9H5.2L5 25.3l-.8 2a1.53 1.53 0 01-1.9.9l-1.2-.4a1.58 1.58 0 01-1-1.9v-.1c.3-.9 3.1-11.2 3.1-11.2a2.66 2.66 0 012.3-2l.6-.5a6.93 6.93 0 014.7-12 6.8 6.8 0 014.9 2 7 7 0 012 4.9 6.65 6.65 0 01-2.2 5l.7.5a2.78 2.78 0 012.4 2s2.9 11.2 2.9 11.3a1.53 1.53 0 01-.9 1.9l-1.3.4a1.63 1.63 0 01-1.9-.9l-.7-1.8z" fill="#333" opacity=".7"/><path d="m5.9 13.6 1.1-.9h7.8l1.2.9" fill="#ce592c"/><ellipse cx="10.9" cy="13.1" rx="2.7" ry=".3" fill="#ce592c" opacity=".5"/><path d="m20.6 26.1-2.9-11.3a1.71 1.71 0 00-1.6-1.2H5.7a1.69 1.69 0 00-1.5 1.3L1.1 26.2a.61.61 0 00.3.7l1.1.4a.61.61 0 00.7-.3l2.7-6.7.2 16.8h3.6l.6-9.3a.47.47 0 01.44-.5h.06c.4 0 .4.2.5.5l.6 9.3h3.6l.2-16.8 2.5 6.6a.52.52 0 00.66.31l1.2-.4a.57.57 0 00.5-.7Z" fill="#fdbf2d"/><path d="m7 13.6 3.9 6.7 3.9-6.7" fill="#cf572e" opacity=".6"/><circle cx="10.9" cy="7" r="5.9" fill="#fdbf2d"/></svg>',
                        iconSize: [44, 44],
                        iconAnchor: [22, 42]
                    });

                    currentMarker = L.marker([latNum, lngNum], {
                        icon: pegmanIcon,
                        draggable: true
                    }).addTo(map);

                    map.setView([latNum, lngNum], 15);

                    var mapErr = document.getElementById("mapError");
                    if (mapErr) {
                        mapErr.textContent = "✅ تم تحديد الموقع بنجاح!";
                        mapErr.style.display = "block";
                        mapErr.style.color = "#22c55e";
                        setTimeout(function() {
                            mapErr.style.display = "none";
                        }, 3000);
                    }
                }
            }
        }

        // ====== دالة تغيير المدينة ======
        function onCityChange(cityId) {
            var cityName = document.getElementById('citySelect').selectedOptions[0]?.text;
            if (cityName && syriaCities[cityName] && map) {
                var c = syriaCities[cityName];
                map.setView([c.lat, c.lng], c.zoom || 13);
                if (currentMarker) {
                    map.removeLayer(currentMarker);
                    currentMarker = null;
                }
                document.getElementById("latDisplay").innerHTML = "--";
                document.getElementById("lngDisplay").innerHTML = "--";
                document.getElementById("inputLat").value = "";
                document.getElementById("inputLng").value = "";
                var mapErr = document.getElementById("mapError");
                if (mapErr) mapErr.style.display = "block";
                // إعادة إضافة الرجل الأصفر بعد تغيير المدينة
                setTimeout(function() {
                    addPegmanToMap();
                }, 300);
            }
        }

        // ====== دالة تغيير طبقة الخريطة ======
        function setLayer(type) {
            if (!map) return;
            var btnMap = document.getElementById("btnMap");
            var btnSat = document.getElementById("btnSat");

            if (type === "satellite") {
                if (map.hasLayer(map._baseLayer)) map.removeLayer(map._baseLayer);
                map._satelliteLayer.addTo(map);
                map._satelliteLabels.addTo(map);
                btnSat.classList.add("active");
                btnMap.classList.remove("active");
            } else {
                if (map.hasLayer(map._satelliteLayer)) map.removeLayer(map._satelliteLayer);
                if (map.hasLayer(map._satelliteLabels)) map.removeLayer(map._satelliteLabels);
                map._baseLayer.addTo(map);
                btnMap.classList.add("active");
                btnSat.classList.remove("active");
            }
        }

        // ====== دالة ملء الشاشة ======
        function toggleFullscreen() {
            var w = document.getElementById("mapWrapper");
            if (!document.fullscreenElement) {
                w.requestFullscreen();
            } else {
                document.exitFullscreen();
            }
        }

        // ====== دالة إعادة تعيين الموقع ======
        function resetLocation() {
            document.getElementById("latDisplay").innerHTML = "--";
            document.getElementById("lngDisplay").innerHTML = "--";
            document.getElementById("inputLat").value = "";
            document.getElementById("inputLng").value = "";
            if (currentMarker) {
                map.removeLayer(currentMarker);
                currentMarker = null;
            }
            var mapErr = document.getElementById("mapError");
            if (mapErr) {
                mapErr.textContent = "⚠️ لم تحدد الموقع على الخريطة";
                mapErr.style.display = "block";
                mapErr.style.color = "#f59e0b";
                setTimeout(function() {
                    mapErr.style.display = "none";
                }, 3000);
            }
            // إعادة إضافة الرجل الأصفر
            setTimeout(function() {
                addPegmanToMap();
            }, 300);
        }

        // ====== دوال التنقل بين الخطوات ======
        function changeStep(dir) {
            var next = currentStep + dir;
            if (next < 1 || next > 5) return;

            if (dir > 0 && !validateCurrentStep()) {
                return;
            }

            document.querySelector('.form-step[data-step="' + currentStep + '"]').classList.add("hidden");
            document.querySelector('.form-step[data-step="' + next + '"]').classList.remove("hidden");
            updateTimeline(next);
            currentStep = next;

            if (currentStep === 3) {
                setTimeout(function() {
                    if (!map) {
                        initMap(document.getElementById('citySelect').value);
                    } else {
                        setTimeout(function() {
                            map.invalidateSize();
                        }, 100);
                    }
                }, 150);
            }

            window.scrollTo({ top: 0, behavior: "smooth" });
        }

        // ====== دالة تحديث التايم لاين ======
        function updateTimeline(step) {
            document.querySelectorAll(".timeline .step").forEach(function(el) {
                var s = parseInt(el.dataset.step);
                el.classList.remove("active", "completed");
                if (s < step) el.classList.add("completed");
                else if (s === step) el.classList.add("active");
            });

            var prev = document.getElementById("prevBtn");
            var next = document.getElementById("nextBtn");
            var pub = document.getElementById("pubBtn");

            if (prev) prev.style.display = step === 1 ? "none" : "flex";
            if (next) next.style.display = step === 5 ? "none" : "flex";
            if (pub) pub.style.display = step === 5 ? "flex" : "none";

            syncLine();
        }

        // ====== دالة مزامنة الخط ======
        function syncLine() {
            var tl = document.getElementById("timeline");
            var circles = document.querySelectorAll(".timeline .circle");
            if (!circles.length || !tl) return;

            var bgLine = document.getElementById("bgLine");
            var progress = document.getElementById("progress");
            var tR = tl.getBoundingClientRect();
            var fR = circles[0].getBoundingClientRect();
            var lR = circles[circles.length - 1].getBoundingClientRect();
            var active = document.querySelector(".timeline .step.active .circle") || circles[0];
            var aR = active.getBoundingClientRect();

            var tF = fR.top + fR.height / 2 - tR.top;
            var tL = lR.top + lR.height / 2 - tR.top;
            var tA = aR.top + aR.height / 2 - tR.top;
            var rP = tR.width - (fR.left + fR.width / 2 - tR.left) - 1;

            if (bgLine) {
                bgLine.style.top = tF + "px";
                bgLine.style.right = rP + "px";
                bgLine.style.height = Math.max(0, tL - tF) + "px";
            }
            if (progress) {
                progress.style.top = tF + "px";
                progress.style.right = rP + "px";
                progress.style.height = Math.max(0, tA - tF) + "px";
            }
        }

        // ====== دوال التحقق من صحة البيانات ======
        function validateCurrentStep() {
            var step = currentStep;
            var stepDiv = document.querySelector('.form-step[data-step="' + step + '"]');
            var required = stepDiv.querySelectorAll("[required]");
            var isValid = true;

            required.forEach(function(field) {
                // تجاهل الحقول المخفية في الخطوة 3 (الخريطة)
                if (field.id === "inputLat" || field.id === "inputLng") {
                    return;
                }

                if (!field.value || field.value === "") {
                    field.classList.add("error");
                    var errorDiv = field.parentElement.querySelector(".error-message");
                    if (errorDiv) errorDiv.style.display = "block";
                    isValid = false;
                } else {
                    field.classList.remove("error");
                    var errorDiv = field.parentElement.querySelector(".error-message");
                    if (errorDiv) errorDiv.style.display = "none";
                }
            });

            if (step === 2) {
                var mainImg = document.getElementById("mainImg");
                if (!mainImg.files || mainImg.files.length === 0) {
                    var err = document.getElementById("mainImgError");
                    if (err) err.style.display = "block";
                    isValid = false;
                } else {
                    var err = document.getElementById("mainImgError");
                    if (err) err.style.display = "none";
                }
            }

            if (step === 3) {
                var lat = document.getElementById("inputLat").value;
                var lng = document.getElementById("inputLng").value;

                if (!lat || !lng) {
                    var mapErr = document.getElementById("mapError");
                    if (mapErr) {
                        mapErr.textContent = "⚠️ لم تحدد الموقع على الخريطة، يمكنك تخطي هذه الخطوة مؤقتاً";
                        mapErr.style.display = "block";
                        mapErr.style.color = "#f59e0b";
                    }
                    return true;
                } else {
                    var mapErr = document.getElementById("mapError");
                    if (mapErr) mapErr.style.display = "none";
                }
            }

            return isValid;
        }

        // ====== دوال رفع الصور ======
        function handleMainImg(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById("mainImgPrev").innerHTML = '<div class="uploaded-img"><img src="' + e.target.result + '"><button type="button" class="remove-btn" onclick="removeMainImg()"><i class="fa-solid fa-xmark"></i></button></div>';
                    var err = document.getElementById("mainImgError");
                    if (err) err.style.display = "none";
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function removeMainImg() {
            document.getElementById("mainImgPrev").innerHTML = "";
            document.getElementById("mainImg").value = "";
            var err = document.getElementById("mainImgError");
            if (err) err.style.display = "block";
        }

        function handlePropImgs(input) {
            if (input.files) {
                var prev = document.getElementById("propImgsPrev");
                Array.from(input.files).forEach(function(file) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        prev.innerHTML += '<div class="uploaded-img"><img src="' + e.target.result + '"><button type="button" class="remove-btn" onclick="this.closest(\'.uploaded-img\').remove()"><i class="fa-solid fa-xmark"></i></button></div>';
                    };
                    reader.readAsDataURL(file);
                });
            }
        }

        // ====== دوال التبويب ======
        function switchTab(tabId, btn) {
            document.querySelectorAll(".tab-content").forEach(function(t) {
                t.classList.remove("active");
            });
            document.querySelectorAll(".tab-btn").forEach(function(b) {
                b.classList.remove("active");
            });
            document.getElementById(tabId).classList.add("active");
            btn.classList.add("active");
        }

        // ====== تهيئة الصفحة ======
        document.addEventListener('DOMContentLoaded', function() {
            var today = new Date().toISOString().split('T')[0];
            var availableFrom = document.getElementById('available_from');
            if (availableFrom) {
                availableFrom.setAttribute('min', today);
            }

            // إدخال خط الطول والعرض يدوياً
            var inputLat = document.getElementById("inputLat");
            var inputLng = document.getElementById("inputLng");

            if (inputLat) {
                inputLat.addEventListener('change', updateLocationFromInputs);
                inputLat.addEventListener('input', updateLocationFromInputs);
            }
            if (inputLng) {
                inputLng.addEventListener('change', updateLocationFromInputs);
                inputLng.addEventListener('input', updateLocationFromInputs);
            }

            // تهيئة الخريطة بعد تحميل الصفحة
            setTimeout(function() {
                var citySelect = document.getElementById('citySelect');
                var cityId = citySelect?.value || 1;
                initMap(cityId);
                updateTimeline(1);
            }, 500);

            // تحديث حجم الخريطة عند تغيير حجم النافذة
            window.addEventListener('resize', function() {
                if (map) {
                    setTimeout(function() {
                        map.invalidateSize();
                    }, 300);
                }
            });
        });

        // ====== Scroll to top button ======
        window.onscroll = function() {
            var btn = document.getElementById('scrollBtn');
            if (btn) {
                btn.classList.toggle('show', document.documentElement.scrollTop > 300);
            }
        };
    </script>
</body>
</html>