@model RealEstateWebApp.Models.PropertyViewModel
@{
    ViewData["Title"] = "أعلن عن عقارك";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | SYRELIS - العقارات الفاخرة</title>

    <!-- ====== جميع CDN ====== -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <style>
        :root {
            --dark: #192e43;
            --gold: #d4af37;
            --gray: #51596a;
            --white: #ffffff;
            --border: #e8e4dc;
            --bg-light: #f8f9fa;
            --shadow: 0 4px 16px rgba(11, 19, 32, 0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #0b1320;
            font-family: 'Tajawal', sans-serif;
            color: var(--gold);
            line-height: 1.6;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
        }

        .navbar {
            background: rgba(11, 19, 32, 0.96);
            padding: 0 1rem;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(212, 175, 55, 0.4);
            justify-content: space-evenly;
            box-shadow: 0px 15px 30px -10px rgb(23, 22, 70);
            position: sticky;
            top: 0;
            z-index: 2000;
            flex-wrap: wrap;
            gap: 10px;
        }

        .logo {
            width: 6%;
            margin-top: 8px;
            margin-bottom: 8px;
            min-width: 50px;
            flex-shrink: 0;
        }

        .nav-links {
            padding: 0 18rem;
            display: flex;
            gap: 70px;
            list-style: none;
            flex-wrap: wrap;
            justify-content: center;
        }

            .nav-links a {
                color: #f2efea;
                text-decoration: none;
                font-weight: 600;
                font-size: 1rem;
                transition: 0.3s;
                white-space: nowrap;
            }

                .nav-links a:hover {
                    color: #d4af37;
                }

        .tabs {
            display: flex;
            gap: 6px;
            margin-top: 25px;
            margin-bottom: 28px;
            background: var(--bg-light);
            padding: 6px;
            border-radius: 12px;
            flex-wrap: wrap;
        }

        .tab-btn {
            flex: 1;
            background: transparent;
            border: none;
            padding: 13px 18px;
            font-family: "Tajawal", sans-serif;
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--gray);
            cursor: pointer;
            border-radius: 10px;
            transition: all 0.25s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .tab-btn i {
                font-size: 1.05rem;
            }

            .tab-btn:hover {
                color: var(--gold);
            }

            .tab-btn.active {
                background: #192e43;
                color: #fffefb;
                box-shadow: -9px 4px 16px rgb(10 24 47 / 45%);
            }

        .tab-content {
            display: none;
            animation: fadeUp 0.4s ease;
        }

            .tab-content.active {
                display: block !important;
            }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .card {
            max-width: 100%;
            background: var(--white);
            border-radius: 20px;
            padding: 28px;
            margin-top: 50px;
            margin-bottom: 61px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

            .form-group.full {
                grid-column: 1 / -1;
            }

            .form-group label {
                font-weight: 500;
                color: var(--dark);
                font-size: 1rem;
            }

                .form-group label .req {
                    font-weight: 800;
                    color: #b20011;
                    font-size: 1.3rem;
                }

        .form-control {
            padding: 12px 15px;
            border: 2px solid var(--border);
            border-radius: 10px;
            font-family: "Tajawal", sans-serif;
            font-size: 0.95rem;
            background: var(--white);
            color: var(--dark);
            transition: all 0.25s;
        }

            .form-control:focus {
                outline: none;
                border-color: #192e43;
                box-shadow: 0 0 0 2px rgb(215 219 232);
            }

        .form-step {
            display: block !important;
        }

            .form-step.hidden {
                display: none !important;
            }

        .main-layout {
            margin-top: 63px;
            display: flex !important;
            flex-direction: row !important;
            gap: 28px !important;
        }

        .steps-sidebar {
            width: 320px !important;
            flex-shrink: 0 !important;
        }

        .steps-sticky {
            position: sticky;
            top: 110px;
        }

        .timeline {
            gap: 1.5rem;
            display: flex;
            height: 35.5rem;
            background: var(--white);
            border-radius: 20px;
            padding: 35px 30px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
            flex-direction: column;
            position: relative;
        }

        .step {
            display: flex !important;
            align-items: center;
            gap: 18px;
            padding: 14px 0;
            cursor: pointer;
            position: relative;
            z-index: 2;
        }

        .circle {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--white);
            border: 2px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1rem;
            color: var(--gray);
            transition: all 0.3s ease;
            flex-shrink: 0;
            z-index: 2;
        }

        .info {
            flex: 1;
        }

        .info-title {
            font-size: 1rem;
            font-weight: 600;
            color: var(--dark);
        }

        .info-sub {
            font-size: 0.82rem;
            color: #999;
        }

        .step.active .circle {
            border-color: #4e5468;
            background: var(--dark);
            color: white;
            transform: scale(1.08);
            box-shadow: 0 0 0 5px rgb(17 44 121 / 17%);
        }

        .step.active .info-title {
            color: #022242;
            font-size: 19px;
            font-weight: 700;
        }

        .step.active .info-sub {
            color: #000000;
        }

        .step.completed .circle {
            box-shadow: 0 0 0 5px rgb(169 160 9 / 17%);
            border-color: #795e08;
            background: #d4af37;
            width: 52px;
            height: 52px;
            color: white;
        }

            .step.completed .circle::after {
                content: "✓";
                font-size: 1.5rem;
            }

            .step.completed .circle span {
                display: none;
            }

        .content-area {
            margin-top: -51px;
            flex: 1;
            min-width: 0;
        }

        .btn {
            padding: 12px 26px;
            border: none;
            border-radius: 10px;
            font-family: "Tajawal", sans-serif;
            font-size: 0.98rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        .btn-primary {
            background: var(--dark);
            color: #ffffff;
            box-shadow: -1px 2px 9px rgb(11 19 32 / 73%);
        }

        .btn-secondary {
            border: 1px solid #1a3250;
            background: #1a314d;
            color: #ffffff;
            border-radius: 10px;
            padding: 10px 20px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }

            .btn-primary:hover, .btn-secondary:hover {
                background: #ffffff;
                color: #1a3250;
            }

        .form-actions {
            display: flex !important;
            justify-content: space-between;
            padding-top: 23px !important;
        }

        .btn-group {
            display: flex;
            gap: 11px;
        }

        .upload-box {
            border: 2px dashed var(--border);
            border-radius: 14px;
            padding: 32px 20px;
            text-align: center;
            background: var(--bg-light);
            cursor: pointer;
            transition: all 0.3s;
        }

            .upload-box:hover {
                border-color: #05155e;
                background: #e8e5cf69;
            }

            .upload-box i {
                font-size: 2.8rem;
                color: var(--gold);
                margin-bottom: 10px;
            }

        .uploaded-images {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 14px;
            margin-top: 18px;
        }

        .uploaded-img {
            position: relative;
            aspect-ratio: 4/3;
            border-radius: 10px;
            overflow: hidden;
            border: 2px solid var(--border);
        }

            .uploaded-img img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .uploaded-img .remove-btn {
                position: absolute;
                top: 5px;
                right: 5px;
                background: var(--gold);
                color: var(--dark);
                border: none;
                width: 26px;
                height: 26px;
                border-radius: 50%;
                cursor: pointer;
            }

        .map-wrapper {
            position: relative;
            width: 100%;
            height: 65vh;
            min-height: 400px;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
            background: #e5e7eb;
        }

        #map {
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .coords-box {
            text-align: center;
            background: #e8e5cf69;
            padding: 16px 6px;
            border-radius: 10px;
            margin-top: 14px;
            display: flex;
            gap: 11px;
            flex-wrap: wrap;
            border: 1px solid #0f377e;
        }

        .coord-item {
            display: flex;
            flex-direction: column;
            gap: 5px;
            flex: 1;
            min-width: 282px;
        }

            .coord-item label {
                font-weight: 700;
                color: var(--dark);
                font-size: 1rem;
            }

            .coord-item span {
                font-family: "Courier New", monospace;
                font-size: 1.05rem;
                color: var(--dark);
                font-weight: 700;
                background: var(--white);
                padding: 7px 12px;
                border-radius: 7px;
                border: 1px solid var(--border);
            }

        .hawya {
            display: flex;
            align-items: center;
            gap: 60px;
            flex-wrap: wrap;
        }

        .amenities-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 11px;
        }

        .amenity-item {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 13px 15px;
            background: var(--bg-light);
            border: 2px solid var(--border);
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            color: var(--dark);
        }

            .amenity-item input[type="checkbox"] {
                width: 19px;
                height: 19px;
                accent-color: #f7cc43;
                cursor: pointer;
            }

        .error-message {
            color: #e5192c;
            font-size: 0.95rem;
            margin-top: 4px;
            display: none;
        }

        .form-control.error {
            border-color: #dc3545 !important;
        }

        select.form-control {
            appearance: none;
            -webkit-appearance: none;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%23333' stroke-width='2'><polyline points='6 9 12 15 18 9'/></svg>");
            background-repeat: no-repeat;
            background-position: left 12px center;
            padding: 10px 12px 10px 35px;
            background-color: white;
            cursor: pointer;
        }

        .scroll-top {
            color: #192e43;
            font-size: 18px;
            position: fixed;
            bottom: 21px;
            right: 26px;
            width: 44px;
            height: 44px;
            background: #ffffff;
            border: 3px solid #1a314d;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s;
            z-index: 999;
        }

            .scroll-top.show {
                opacity: 1;
                visibility: visible;
            }

        .hidden {
            display: none !important;
        }

        .control-container {
            position: absolute;
            top: 12px;
            left: 12px;
            z-index: 1000;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
            padding: 4px;
            display: flex;
            gap: 4px;
        }

        .map-btn {
            border: none;
            background: transparent;
            padding: 10px 16px;
            font-size: 14px;
            font-weight: 500;
            color: #444;
            cursor: pointer;
            border-radius: 6px;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
        }

            .map-btn:hover {
                background: #f5f5f5;
            }

            .map-btn.active {
                background: #e8f0fe;
                color: #1a73e8;
                font-weight: 600;
            }

        .fullscreen-btn {
            position: absolute;
            top: 1rem;
            right: 0.6rem;
            z-index: 1000;
            width: 35px;
            height: 35px;
            background: #fff;
            border: 2px solid #bababa;
            border-radius: 8px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
            cursor: pointer;
        }

        .pegman-btn {
            position: absolute;
            bottom: 27px;
            right: 5px;
            z-index: 1000;
            width: 48px;
            height: 48px;
            background: #fff;
            border: none;
            border-radius: 8px;
            box-shadow: 0 3px 4px rgb(0 0 0);
            cursor: grab;
        }

        .btn-reset-location {
            font-family: "Tajawal", sans-serif;
            border: 2px solid #0f377e;
            border-radius: 15px;
            font-size: 1rem;
            color: #000000;
            background: #aacbc8;
            padding: 17px 23px;
            cursor: pointer;
            height: fit-content;
            margin-top: 14px;
            font-weight: 500;
        }

        .restart {
            flex: 0 0 auto;
        }

        .timeline-bg-line, .timeline-progress {
            position: absolute;
            width: 2px;
            border-radius: 1px;
            pointer-events: none;
            right: 21px;
        }

        .timeline-bg-line {
            background: var(--border);
        }

        .timeline-progress {
            background: var(--gold);
            height: 0;
            transition: height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1;
        }

        @@media screen and (max-width: 1200px) {
            .nav-links {
                padding: 0 8rem;
                gap: 40px;
            }

            .main-layout {
                flex-direction: column !important;
            }

            .steps-sidebar {
                width: 100% !important;
            }

            .steps-sticky {
                position: relative;
                top: 0;
            }

            .timeline {
                height: auto;
                flex-direction: row;
                flex-wrap: wrap;
                padding: 20px;
                gap: 10px;
                justify-content: center;
            }

            .timeline-bg-line, .timeline-progress {
                display: none;
            }

            .step {
                flex: 0 0 auto;
                padding: 10px 15px;
                background: var(--bg-light);
                border-radius: 10px;
                border: 2px solid transparent;
            }
        }

        @@media screen and (max-width: 992px) {
            .navbar {
                justify-content: center;
                padding: 10px 15px;
            }

            .nav-links {
                padding: 0 2rem;
                gap: 25px;
            }

            .container {
                padding: 1.2rem;
            }

            .main-layout {
                flex-direction: column !important;
            }

            .steps-sidebar {
                width: 100% !important;
            }

            .steps-sticky {
                position: relative;
                top: 0;
            }

            .timeline {
                height: auto;
                flex-direction: row;
                flex-wrap: wrap;
                padding: 15px;
                gap: 8px;
                justify-content: center;
            }

            .timeline-bg-line, .timeline-progress {
                display: none;
            }

            .step {
                flex: 0 0 auto;
                padding: 8px 12px;
                background: var(--bg-light);
                border-radius: 8px;
                border: 2px solid transparent;
                gap: 10px;
            }
        }

        @@media screen and (max-width: 768px) {
            .navbar {
                flex-direction: column;
                padding: 10px;
                justify-content: center;
            }

            .logo {
                width: 50px;
            }

            .nav-links {
                padding: 0;
                gap: 15px;
                justify-content: center;
            }

            .container {
                padding: 0.8rem;
            }

            .main-layout {
                flex-direction: column !important;
            }

            .steps-sidebar {
                width: 100% !important;
            }

            .steps-sticky {
                position: relative;
                top: 0;
            }

            .timeline {
                height: auto;
                flex-direction: row;
                flex-wrap: wrap;
                padding: 12px;
                gap: 6px;
                justify-content: center;
            }

            .timeline-bg-line, .timeline-progress {
                display: none;
            }

            .step {
                flex: 0 0 auto;
                padding: 6px 10px;
                background: var(--bg-light);
                border-radius: 8px;
                border: 2px solid transparent;
                gap: 8px;
            }

                .step .info-sub {
                    display: none;
                }

            .circle {
                width: 28px;
                height: 28px;
                font-size: 0.65rem;
            }

            .step.completed .circle {
                width: 32px;
                height: 32px;
            }

            .info-title {
                font-size: 0.75rem;
            }

            .card {
                padding: 15px;
                border-radius: 14px;
                max-width: 100%;
                margin-right: 0;
            }

            .form-grid {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .form-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .btn-group {
                justify-content: center;
            }

            .btn {
                padding: 10px 18px;
                font-size: 0.9rem;
                border-radius: 8px;
                justify-content: center;
            }

            .map-wrapper {
                height: 40vh;
                min-height: 250px;
            }

            .coords-box {
                padding: 12px 15px;
                gap: 12px;
            }

            .coord-item {
                min-width: 140px;
            }

            .amenities-grid {
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
                gap: 8px;
            }

            .upload-box {
                padding: 20px 15px;
            }

                .upload-box i {
                    font-size: 2rem;
                }

            .uploaded-images {
                grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
                gap: 10px;
            }
        }

        @@media screen and (max-width: 480px) {
            .nav-links {
                gap: 8px;
            }

                .nav-links a {
                    font-size: 0.7rem;
                }

            .container {
                padding: 0.5rem;
            }

            .tab-btn {
                padding: 6px 10px;
                font-size: 0.7rem;
            }

            .timeline {
                padding: 8px;
                gap: 4px;
            }

            .step {
                padding: 4px 8px;
                gap: 6px;
            }

            .circle {
                width: 24px;
                height: 24px;
                font-size: 0.55rem;
            }

            .info-title {
                font-size: 0.65rem;
            }

            .card {
                padding: 12px;
            }

            .form-control {
                padding: 8px 10px;
                font-size: 0.8rem;
            }

            .coord-item {
                min-width: 100px;
            }

            .amenities-grid {
                grid-template-columns: 1fr 1fr;
                gap: 6px;
            }

            .uploaded-images {
                grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
                gap: 8px;
            }
        }
    </style>
</head>
<body>

    <!-- ========== شريط التنقل ========== -->
    <nav class="navbar">
        <img class="logo" src="~/hero.png" alt="Logo">
        <ul class="nav-links">
            <li><a href="@Url.Action("Index", "Home")">الرئيسية</a></li>
            <li><a href="@Url.Action("Create", "Properties")" id="announceLink"><span class="link_span">أعلن عن عقارك</span></a></li>
            <li><a href="@Url.Action("Index", "Search")" id="searchLink"><span class="link_span">ابحث عن عقارك</span></a></li>
            <li><a href="@Url.Action("Index", "Dashboard")"><span class="link_span">حسابي</span></a></li>
            <li><a href="@Url.Action("Index", "Home")#contactSection" id="contactNavLink"><span class="link_span">تواصل معنا</span></a></li>
        </ul>
    </nav>

    <div class="container">
        <div class="page-header">
            <h1 class="page-title">
                <i class="fa-solid fa-user-tie"></i> لوحة التحكم
            </h1>
        </div>

        <div class="tabs">
            <button class="tab-btn" onclick="switchTab('favorites', this)">
                <i class="fa-solid fa-heart"></i> المفضلة
            </button>
            <button class="tab-btn active" id="addPropertyBtn" onclick="switchTab('addProperty', this)">
                <i class="fa-solid fa-plus"></i> إضافة عقار
            </button>
            <button class="tab-btn" onclick="window.location.href='@Url.Action("MyProperties", "Properties")'">
                <i class="fa-solid fa-building"></i> عقاراتي
            </button>
            <button class="tab-btn" onclick="switchTab('myNeeds', this)">
                <i class="fas fa-home"></i> اطلب عقار
            </button>
        </div>

        <!-- Tab: Add Property -->
        <div id="addProperty" class="tab-content active">
            <div class="main-layout">
                <aside class="steps-sidebar">
                    <div class="steps-sticky">
                        <div class="timeline" id="timeline">
                            <div class="timeline-bg-line" id="bgLine"></div>
                            <div class="timeline-progress" id="progress"></div>
                            <div class="step active" data-step="1">
                                <div class="circle"><span>1</span></div>
                                <div class="info">
                                    <div class="info-title">الوصف</div>
                                    <div class="info-sub">معلومات أساسية</div>
                                </div>
                            </div>
                            <div class="step" data-step="2">
                                <div class="circle"><span>2</span></div>
                                <div class="info">
                                    <div class="info-title">الوسائط</div>
                                    <div class="info-sub">صور وفيديو</div>
                                </div>
                            </div>
                            <div class="step" data-step="3">
                                <div class="circle"><span>3</span></div>
                                <div class="info">
                                    <div class="info-title">الموقع</div>
                                    <div class="info-sub">تحديد على الخريطة</div>
                                </div>
                            </div>
                            <div class="step" data-step="4">
                                <div class="circle"><span>4</span></div>
                                <div class="info">
                                    <div class="info-title">التفاصيل</div>
                                    <div class="info-sub">المواصفات الفنية</div>
                                </div>
                            </div>
                            <div class="step" data-step="5">
                                <div class="circle"><span>5</span></div>
                                <div class="info">
                                    <div class="info-title">المرافق</div>
                                    <div class="info-sub">الخدمات المتاحة</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </aside>

                <div class="content-area">
                    <div class="card">
                        <form asp-action="Create" method="post" enctype="multipart/form-data" id="propForm">
                            @Html.AntiForgeryToken()

                            <!-- ====== الخطوة 1 ====== -->
                            <div class="form-step" data-step="1">
                                <div class="form-grid">
                                    <div class="form-group">
                                        <label>نوع العقار <span class="req">*</span></label>
                                        <select asp-for="PropertyTypeId" class="form-control" required>
                                            <option value="" disabled selected hidden>اختر النوع</option>
                                            @if (Model.PropertyTypes != null)
                                            {
                                                foreach (var type in Model.PropertyTypes)
                                                {
                                                    <option value="@type.Id">@type.NameAr</option>
                                                }
                                            }
                                        </select>
                                        <span asp-validation-for="PropertyTypeId" class="error-message"></span>
                                    </div>

                                    <div class="form-group">
                                        <label>طبيعة العقار <span class="req">*</span></label>
                                        <select asp-for="Status" class="form-control" required>
                                            <option value="" disabled hidden>اختر</option>
                                            <option value="للبيع" selected>للبيع</option>
                                        </select>
                                        <span asp-validation-for="Status" class="error-message"></span>
                                    </div>

                                    <div class="form-group">
                                        <label>السعر <span class="req">*</span></label>
                                        <input asp-for="Price" type="number" class="form-control" placeholder="أدخل السعر" required min="0" />
                                        <span asp-validation-for="Price" class="error-message"></span>
                                    </div>

                                    <div class="form-group">
                                        <label>العملة <span class="req">*</span></label>
                                        <select asp-for="PriceCurrency" class="form-control" required>
                                            <option value="" disabled hidden>اختر</option>
                                            <option value="USD" selected>دولار أمريكي</option>
                                            <option value="SYP">ليرة سورية</option>
                                        </select>
                                        <span asp-validation-for="PriceCurrency" class="error-message"></span>
                                    </div>

                                    <div class="form-group full">
                                        <label>ضع عنوان مناسب للعقار <span class="req">*</span></label>
                                        <input asp-for="Title" class="form-control" placeholder="اكتب عنواناً مناسباً للعقار..." required />
                                        <span asp-validation-for="Title" class="error-message"></span>
                                    </div>

                                    <div class="form-group full">
                                        <label>أضف تفاصيل إضافية (الوصف المفصل للعقار)</label>
                                        <textarea asp-for="Description" class="form-control" placeholder="اكتب وصفاً مفصلاً للعقار..."></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- ====== الخطوة 2 ====== -->
                            <div class="form-step hidden" data-step="2">
                                <div class="form-group">
                                    <label>الصورة الأساسية <span class="req">*</span></label>
                                    <div class="upload-box" onclick="document.getElementById('mainImg').click()">
