@model List<RealEstateWebApp.Models.Property>
@{
    ViewData["Title"] = "عقاراتي";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>عقاراتي | SYRELIS</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet" />

    <style>
        :root {
            --dark: #192e43;
            --gold: #d4af37;
            --gray: #51596a;
            --white: #ffffff;
            --gold-light: #f4e5c2;
            --border: #e8e4dc;
            --bg-light: #f8f9fa;
            --shadow: 0 4px 16px rgba(11, 19, 32, 0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(126deg, rgba(11, 19, 32, 0.85), rgb(11 19 32 / 62%)), url(https://images.unsplash.com/photo-1600585154526-990dced4db0d?q=80&w=2070&auto=format);
            background-size: cover;
            background-position: center;
            font-family: "Tajawal", sans-serif;
            color: var(--gold);
            line-height: 1.6;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
        }

        /* ====== نافبار ====== */
        .navbar {
            background: rgba(11, 19, 32, 0.96);
            padding: 0 1rem;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(212, 175, 55, 0.4);
            justify-content: space-evenly;
            box-shadow: 0px 15px 30px -10px rgb(23, 22, 70);
            position: sticky;
            top: 0;
            z-index: 2000;
            flex-wrap: wrap;
            gap: 10px;
        }

        .logo {
            width: 6%;
            margin-top: 8px;
            margin-bottom: 8px;
            min-width: 50px;
            flex-shrink: 0;
        }

        .nav-links {
            padding: 0 18rem;
            display: flex;
            gap: 70px;
            list-style: none;
            flex-wrap: wrap;
            justify-content: center;
        }

            .nav-links a {
                color: #f2efea;
                text-decoration: none;
                font-weight: 600;
                font-size: 1rem;
                transition: 0.3s;
                white-space: nowrap;
            }

                .nav-links a:hover {
                    color: #d4af37;
                }

        /* ====== كارد ====== */
        .card {
            max-width: 100%;
            background: var(--white);
            border-radius: 20px;
            padding: 28px;
            margin-top: 50px;
            margin-bottom: 61px;
        }

        .card-header {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--dark);
            margin-bottom: 22px;
            padding-bottom: 14px;
            border-bottom: 2px solid var(--bg-light);
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .card-header .icon-circle {
                width: 40px;
                height: 40px;
                background: #192e43;
                border-radius: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #ffd754;
                font-size: 1.2rem;
            }
        /* ====== جدول ====== */
        .table-wrap {
            overflow-x: auto;
            border-radius: 10px;
            margin-top: 20px;
        }

        .needs-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
            table-layout: fixed;
        }

            .needs-table th {
                background: var(--dark);
                color: #ffffff;
                padding: 14px 8px;
                text-align: center;
                font-weight: 800;
                white-space: nowrap;
            }

            .needs-table td {
                padding: 14px 8px;
                text-align: center;
                border-bottom: 1px solid var(--border);
                color: var(--dark);
                vertical-align: middle;
                word-wrap: break-word;
            }

            .needs-table tr:hover {
                background: #f8f6f0;
            }

            /* تحديد عرض كل عمود */
            .needs-table th:nth-child(1) {
                width: 8%;
            }
            /* الصورة */
            .needs-table th:nth-child(2) {
                width: 10%;
            }
            /* رقم المحضر */
            .needs-table th:nth-child(3) {
                width: 12%;
            }
            /* تاريخ النشر */
            .needs-table th:nth-child(4) {
                width: 12%;
            }
            /* نوع العقار */
            .needs-table th:nth-child(5) {
                width: 12%;
            }
            /* السعر */
            .needs-table th:nth-child(6) {
                width: 10%;
            }
            /* طبيعة العقار */
            .needs-table th:nth-child(7) {
                width: 10%;
            }
            /* الحالة */
            .needs-table th:nth-child(8) {
                width: 12%;
            }
            /* التفاصيل */
            .needs-table th:nth-child(9) {
                width: 14%;
            }
        /* الإجراءات */

        .prop-thumb {
            width: 62px;
            height: 62px;
            border-radius: 9px;
            object-fit: cover;
            border: 2px solid var(--border);
        }

        .badge-sale {
            background: var(--gold-light);
            color: var(--dark);
            border: 1px solid var(--gold);
            padding: 5px 13px;
            border-radius: 18px;
            font-size: 0.78rem;
            font-weight: 700;
            display: inline-block;
        }

        .badge-rent {
            background: var(--bg-light);
            color: var(--gray);
            border: 1px solid var(--border);
            padding: 5px 13px;
            border-radius: 18px;
            font-size: 0.78rem;
            font-weight: 700;
            display: inline-block;
        }

        .status-published {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
            padding: 5px 13px;
            border-radius: 18px;
            font-size: 0.78rem;
            font-weight: 700;
            display: inline-block;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
            border: 1px solid #ffeaa7;
            padding: 5px 13px;
            border-radius: 18px;
            font-size: 0.78rem;
            font-weight: 700;
            display: inline-block;
        }

        .status-rejected {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
            padding: 5px 13px;
            border-radius: 18px;
            font-size: 0.78rem;
            font-weight: 700;
            display: inline-block;
        }

        .actions-cell {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .btn-icon-sm {
            width: 34px;
            height: 34px;
            border: none;
            border-radius: 7px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: 0.3s;
        }

        .btn-edit {
            border: 1px solid #44d264;
            background: #d4edda;
            color: #155724;
        }

            .btn-edit:hover {
                background: #28a745;
                color: white;
            }

        .btn-delete {
            border: 1px solid #937b45;
            background: var(--gold-light);
            color: var(--dark);
        }

            .btn-delete:hover {
                background: var(--gold);
                color: var(--white);
            }

        .btn-more {
            background: var(--dark);
            color: var(--gold);
            border: 2px solid var(--gold);
            padding: 6px 16px;
            border-radius: 25px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.3s;
            font-size: 0.8rem;
            font-family: "Tajawal", sans-serif;
        }

            .btn-more:hover {
                background: var(--gold);
                color: var(--dark);
            }

        .empty-state {
            text-align: center;
            padding: 65px 20px;
            background: var(--bg-light);
            border-radius: 20px;
            border: 2px dashed rgba(26, 27, 71, 0.44);
        }

            .empty-state i {
                font-size: 3rem;
                color: var(--gold);
                margin-bottom: 15px;
            }

            .empty-state h3 {
                color: var(--dark);
                font-size: 1.5rem;
            }

            .empty-state p {
                color: var(--gray);
            }

        .btn-primary {
            background: var(--dark);
            color: #ffffff;
            padding: 12px 26px;
            border: none;
            border-radius: 10px;
            font-family: "Tajawal", sans-serif;
            font-size: 0.98rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            text-decoration: none;
            transition: 0.3s;
        }

            .btn-primary:hover {
                background: #ffffff;
                color: #1a3250;
            }

        .login-btn-nav {
            background: transparent;
            border: 1.5px dashed #d4af37;
            color: #d4af37;
            padding: 13px 9px;
            border-radius: 40px;
            font-weight: 700;
            font-size: 0.8rem;
            font-family: "Tajawal", sans-serif;
            cursor: pointer;
            transition: all 0.3s;
            display: inline-block;
            flex-shrink: 0;
        }

            .login-btn-nav:hover {
                background: #d4af37;
                border: 1px solid rgb(50, 39, 11);
                color: #0b1320;
            }

        .success-msg {
            background: rgba(34, 197, 94, 0.15);
            border: 1px solid #22c55e;
            color: #22c55e;
            padding: 12px 20px;
            border-radius: 10px;
            text-align: center;
            margin-bottom: 20px;
        }

        @@media screen and (max-width: 768px) {
            .navbar {
                flex-direction: column;
                padding: 10px;
            }

            .nav-links {
                padding: 0;
                gap: 10px;
                flex-wrap: wrap;
            }

                .nav-links a {
                    font-size: 0.7rem;
                }

            .container {
                padding: 0.5rem;
            }

            .card {
                padding: 12px;
                margin-top: 20px;
                margin-bottom: 30px;
            }
            /* ====== تنسيق الجدول في الشاشات الصغيرة ====== */
            .table-wrap {
                overflow-x: auto;
            }

            .needs-table {
                min-width: 600px;
                font-size: 0.6rem;
                table-layout: fixed;
            }

                .needs-table th,
                .needs-table td {
                    padding: 6px 3px;
                    font-size: 0.55rem;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }
                    /* تحديد عرض الأعمدة في الشاشات الصغيرة */
                    .needs-table th:nth-child(1) {
                        width: 8%;
                    }
                    /* الصورة */
                    .needs-table th:nth-child(2) {
                        width: 8%;
                    }
                    /* رقم المحضر */
                    .needs-table th:nth-child(3) {
                        width: 10%;
                    }
                    /* تاريخ النشر */
                    .needs-table th:nth-child(4) {
                        width: 10%;
                    }
                    /* نوع العقار */
                    .needs-table th:nth-child(5) {
                        width: 12%;
                    }
                    /* السعر */
                    .needs-table th:nth-child(6) {
                        width: 8%;
                    }
                    /* طبيعة العقار */
                    .needs-table th:nth-child(7) {
                        width: 10%;
                    }
                    /* الحالة */
                    .needs-table th:nth-child(8) {
                        width: 12%;
                    }
                    /* التفاصيل */
                    .needs-table th:nth-child(9) {
                        width: 22%;
                    }
            /* الإجراءات */

            .prop-thumb {
                width: 30px;
                height: 30px;
            }

            .btn-icon-sm {
                width: 22px;
                height: 22px;
                font-size: 0.5rem;
            }

            .btn-more {
                padding: 2px 6px;
                font-size: 0.5rem;
                border-width: 1px;
            }

            .badge-sale,
            .badge-rent,
            .status-published,
            .status-pending,
            .status-rejected {
                padding: 2px 4px;
                font-size: 0.45rem;
            }

            .card-header {
                font-size: 0.9rem;
                padding-bottom: 8px;
                margin-bottom: 12px;
            }

                .card-header .icon-circle {
                    width: 30px;
                    height: 30px;
                    font-size: 0.9rem;
                }

            .actions-cell {
                gap: 3px;
            }

            .success-msg {
                font-size: 0.8rem;
                padding: 8px 12px;
            }
        }

        @@media screen and (max-width: 480px) {
            .needs-table {
                min-width: 450px;
                font-size: 0.5rem;
            }

                .needs-table th,
                .needs-table td {
                    padding: 4px 2px;
                    font-size: 0.45rem;
                }

                    .needs-table th:nth-child(7) {
                        width: 8%;
                    }
                    /* الحالة */
                    .needs-table th:nth-child(8) {
                        width: 14%;
                    }
                    /* التفاصيل */
                    .needs-table th:nth-child(9) {
                        width: 26%;
                    }
            /* الإجراءات */

            .btn-more {
                padding: 2px 4px;
                font-size: 0.4rem;
            }

            .btn-icon-sm {
                width: 18px;
                height: 18px;
                font-size: 0.4rem;
            }

            .prop-thumb {
                width: 25px;
                height: 25px;
            }
        }

        }
    </style>
</head>
<body>
   
    <!-- ====== نافبار ====== -->
    <nav class="navbar">
        <img class="logo" src="/hero.png" alt="Logo" style="width:60px; height:auto;">
        <ul class="nav-links">
            <li><a href="/">الرئيسية</a></li>
            <li><a href="/Properties/Create">أعلن عن عقارك</a></li>
            <li><a href="#">ابحث عن عقارك</a></li>
            <li><a href="/Properties/MyProperties">عقاراتي</a></li>
            <li><a href="#">تواصل معنا</a></li>
        </ul>
       
    </nav>

    <!-- ====== المحتوى ====== -->
    <div class="container">
        <div class="card">
            <div class="card-header">
                <div class="icon-circle"><i class="fa-solid fa-building"></i></div>
                عقاراتي
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="success-msg">
                    <i class="fa-solid fa-check-circle"></i> @TempData["Success"]
                </div>
            }

            @if (Model != null && Model.Any())
            {
                <div class="table-wrap">
                    <table class="needs-table">
                        <thead>
                            <tr>
                                <th>الصورة</th>
                                <th>رقم المحضر</th>
                                <th>تاريخ النشر</th>
                                <th>نوع العقار</th>
                                <th>السعر</th>
                                <th>طبيعة العقار</th>
                                <th>الحالة</th>
                                <th>التفاصيل</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var property in Model)
                            {
                                var mainImage = property.Images?.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? "/image/default.jpg";
                                var propertyNumber = property.Code?.Split('-')?.LastOrDefault() ?? "0";
                                var statusClass = property.IsActive ? "status-published" : "status-pending";
                                var statusText = property.IsActive ? "✓ منشور" : "⏳ قيد المراجعة";

                                <tr>
                                    <td><img src="@mainImage" class="prop-thumb" onerror="this.src='/image/default.jpg'" /></td>
                                    <td>@propertyNumber</td>
                                    <td>@property.CreatedAt.ToString("yyyy/MM/dd")</td>
                                    <td>@(property.PropertyType?.NameAr ?? "-")</td>
                                    <td>@property.Price.ToString("N0") @property.PriceCurrency</td>
                                    <td><span class="badge-sale">@property.Status</span></td>
                                    <td><span class="@statusClass">@statusText</span></td>
                                    <td>
                                        <button class="btn-more" onclick="viewProperty(@property.Id)">تفاصيل</button>
                                    </td>
                                    <td style="text-align:center; vertical-align:middle; padding:14px 8px;">
                                        <div style="display:flex; justify-content:center; align-items:center; gap:8px; flex-wrap:nowrap;">
                                            <a href="/Properties/Edit/@property.Id" class="btn-icon-sm btn-edit" title="تعديل">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                            <button class="btn-icon-sm btn-delete" onclick="deleteProperty(@property.Id)" title="حذف">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fa-regular fa-building"></i>
                    <h3>لا توجد عقارات بعد</h3>
                    <p>قم بإضافة عقارك الأول الآن</p>
                    <a href="/Properties/Create" class="btn-primary">
                        <i class="fa-solid fa-plus"></i> إضافة عقار
                    </a>
                </div>
            }
        </div>
    </div>
    <form id="deleteForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
    <!-- ====== مودال تأكيد الحذف ====== -->
    <div id="deleteModal" class="modal-overlay" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.7); z-index:9999; align-items:center; justify-content:center;">
        <div style="background:var(--white); border-radius:28px; max-width:450px; width:90%; padding:40px 30px; text-align:center; position:relative; box-shadow:0 20px 60px rgba(0,0,0,0.5);">
            <div style="font-size:4rem; color:#dc3545; margin-bottom:15px;">
                <i class="fa-solid fa-trash-can"></i>
            </div>
            <h3 style="color:var(--dark); font-size:1.5rem; margin-bottom:10px;">تأكيد الحذف</h3>
            <p style="color:#666; font-size:1.1rem; margin-bottom:25px;" id="deleteMessage">هل أنت متأكد من حذف هذا العقار؟</p>
            <div style="display:flex; gap:15px; justify-content:center;">
                <button onclick="closeDeleteModal()" style="padding:12px 30px; background:#e9ecef; border:none; border-radius:10px; color:#333; font-weight:700; cursor:pointer; font-size:1rem;">
                    إلغاء
                </button>
                <button onclick="confirmDelete()" style="padding:12px 30px; background:#dc3545; border:none; border-radius:10px; color:#fff; font-weight:700; cursor:pointer; font-size:1rem;">
                    تأكيد الحذف
                </button>
            </div>
        </div>
    </div>
    <!-- ====== سكربتات ====== -->
    <script>
              var deleteId = 0;

        function deleteProperty(id) {
            deleteId = id;
            document.getElementById('deleteModal').style.display = 'flex';
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').style.display = 'none';
            deleteId = 0;
        }

                function confirmDelete() {
            if (deleteId === 0) return;

            var token = document.querySelector('#deleteForm input[name="__RequestVerificationToken"]')?.value;

            fetch('/Properties/Delete/' + deleteId, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || ''
                }
            })
            .then(response => response.json())
            .then(data => {
                closeDeleteModal();  // إخفاء المودال

                if (data.success) {
                    // ✅ رسالة نجاح منسقة بدل alert
                    showNotification('✅ تم حذف العقار بنجاح', 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showNotification('❌ حدث خطأ: ' + (data.message || ''), 'error');
                }
            })
            .catch(error => {
                closeDeleteModal();
                showNotification('❌ حدث خطأ أثناء الحذف', 'error');
                console.error(error);
            });
        }
                function showNotification(message, type) {
            // حذف أي إشعار سابق
            var old = document.querySelector('.custom-notification');
            if (old) old.remove();

            var notif = document.createElement('div');
            notif.className = 'custom-notification';
            notif.style.cssText = `
                position: fixed;
                top: 20px;
                left: 50%;
                transform: translateX(-50%);
                padding: 15px 30px;
                border-radius: 12px;
                font-weight: 700;
                font-size: 1.1rem;
                z-index: 99999;
                box-shadow: 0 10px 40px rgba(0,0,0,0.3);
                transition: all 0.3s ease;
                font-family: 'Tajawal', sans-serif;
                ${type === 'success' ? 'background: #22c55e; color: #fff;' : ''}
                ${type === 'error' ? 'background: #dc3545; color: #fff;' : ''}
            `;
            notif.textContent = message;
            document.body.appendChild(notif);

            setTimeout(() => {
                notif.style.opacity = '0';
                setTimeout(() => notif.remove(), 500);
            }, 3000);
        }
        // عرض تفاصيل العقار
        function viewProperty(id) {
            window.location.href = '/Properties/Details/' + id;
        }
    </script>

</body>
</html>