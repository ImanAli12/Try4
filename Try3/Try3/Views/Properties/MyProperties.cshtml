
@model List<RealEstateWebApp.Models.Property>
@using RealEstateWebApp.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@{
    ViewData["Title"] = "عقاراتي";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>عقاراتي | SYRELIS</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --dark: #192e43;
            --gold: #d4af37;
            --gray: #51596a;
            --white: #ffffff;
            --gold-light: #f4e5c2;
            --gold-dark: #917005;
            --border: #e8e4dc;
            --bg-light: #f8f9fa;
            --shadow: 0 4px 16px rgba(11, 19, 32, 0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(126deg, rgba(11, 19, 32, 0.85), rgb(11 19 32 / 62%)), url(https://images.unsplash.com/photo-1600585154526-990dced4db0d?q=80&w=2070&auto=format);
            background-position: center;
            background-attachment: fixed;
            font-family: "Tajawal", sans-serif;
            color: var(--gold);
            line-height: 1.6;
            min-height: 100vh;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
        }

        .navbar {
            background: rgba(11, 19, 32, 0.96);
            padding: 0 1rem;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(212, 175, 55, 0.4);
            justify-content: space-between;
            box-shadow: 0px 15px 30px -10px rgb(23, 22, 70);
            position: sticky;
            top: 0;
            z-index: 2000;
            flex-wrap: wrap;
            gap: 10px;
        }

            .navbar .logo {
                width: 82px;
                margin: 8px 0;
                flex-shrink: 0;
            }

            .navbar .nav-links {
                display: flex;
                gap: 30px;
                list-style: none;
                flex-wrap: wrap;
                justify-content: center;
                padding: 0;
            }

                .navbar .nav-links a {
                    color: #f2efea;
                    text-decoration: none;
                    font-weight: 600;
                    font-size: 0.95rem;
                    transition: 0.3s;
                    white-space: nowrap;
                }

                    .navbar .nav-links a:hover {
                        color: #d4af37;
                    }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-right: 3cm;
        }

        .user-avatar {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: linear-gradient(135deg, #d4af37, #b8941f);
            color: #0b1320;
            font-weight: 800;
            font-size: 1.1rem;
            font-family: 'Tajawal', sans-serif;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid rgba(212, 175, 55, 0.4);
            box-shadow: 0 2px 10px rgba(212, 175, 55, 0.2);
            text-decoration: none;
            user-select: none;
            position: relative;
        }

            .user-avatar:hover {
                transform: scale(1.08);
                box-shadow: 0 4px 20px rgba(212, 175, 55, 0.4);
                border-color: #d4af37;
            }

            .user-avatar .tooltip {
                position: absolute;
                top: 110%;
                left: 50%;
                transform: translateX(-50%);
                background: #0b1320;
                color: #d4af37;
                padding: 6px 14px;
                border-radius: 8px;
                font-size: 0.75rem;
                font-weight: 600;
                white-space: nowrap;
                opacity: 0;
                visibility: hidden;
                transition: all 0.3s ease;
                border: 1px solid rgba(212, 175, 55, 0.2);
                pointer-events: none;
                font-family: 'Tajawal', sans-serif;
            }

            .user-avatar:hover .tooltip {
                opacity: 1;
                visibility: visible;
                top: 120%;
            }

            .user-avatar .tooltip::before {
                content: '';
                position: absolute;
                bottom: 100%;
                left: 50%;
                transform: translateX(-50%);
                border: 6px solid transparent;
                border-bottom-color: #0b1320;
            }

        .page-header {
            padding: 30px 35px;
            margin-bottom: 49px;
            box-shadow: 0 8px 24px rgba(11, 19, 32, 0.15);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
            width: 100%;
            border-bottom: 2px solid #e2bd46;
        }

        .back-button {
            width: 57px;
            height: 54px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 12px 25px;
            background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
            border: 2px solid var(--white);
            border-radius: 12px;
            color: var(--dark);
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            font-family: "Tajawal", sans-serif;
        }

        .page-info {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .page-title h1 {
            color: #e2bd46 !important;
            margin: 0;
            font-size: 2rem;
            font-weight: 800;
        }

        .page-title p {
            color: rgba(255, 255, 255, 0.8);
            font-size: 1rem;
            margin: 5px 0 0 0;
        }

        .card {
            max-width: 100%;
            background: var(--white);
            border-radius: 20px;
            padding: 28px;
            margin-top: 30px;
            margin-bottom: 61px;
        }

        .card-header {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--dark);
            margin-bottom: 22px;
            padding-bottom: 14px;
            border-bottom: 2px solid var(--bg-light);
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .card-header .icon-circle {
                width: 40px;
                height: 40px;
                background: #192e43;
                border-radius: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #ffd754;
                font-size: 1.2rem;
            }

        .table-wrap {
            overflow-x: auto;
            border-radius: 10px;
            margin-top: 20px;
        }

        .needs-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
            table-layout: fixed;
        }

            .needs-table th {
                background: var(--dark);
                color: #ffffff;
                padding: 14px 8px;
                text-align: center;
                font-weight: 800;
                white-space: nowrap;
            }

            .needs-table td {
                padding: 14px 8px;
                text-align: center;
                border-bottom: 1px solid var(--border);
                color: var(--dark);
                vertical-align: middle;
                word-wrap: break-word;
            }

            .needs-table tr:hover {
                background: #f8f6f0;
            }

            .needs-table th:nth-child(1) {
                width: 8%;
            }

            .needs-table th:nth-child(2) {
                width: 10%;
            }

            .needs-table th:nth-child(3) {
                width: 12%;
            }

            .needs-table th:nth-child(4) {
                width: 12%;
            }

            .needs-table th:nth-child(5) {
                width: 12%;
            }

            .needs-table th:nth-child(6) {
                width: 10%;
            }

            .needs-table th:nth-child(7) {
                width: 10%;
            }

            .needs-table th:nth-child(8) {
                width: 12%;
            }

            .needs-table th:nth-child(9) {
                width: 14%;
            }

        .prop-thumb {
            width: 62px;
            height: 62px;
            border-radius: 9px;
            object-fit: cover;
            border: 2px solid var(--border);
        }

        .badge-sale {
            background: var(--gold-light);
            color: var(--dark);
            border: 1px solid var(--gold);
            padding: 5px 13px;
            border-radius: 18px;
            font-size: 0.78rem;
            font-weight: 700;
            display: inline-block;
        }

        .status-published {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
            padding: 5px 13px;
            border-radius: 18px;
            font-size: 0.78rem;
            font-weight: 700;
            display: inline-block;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
            border: 1px solid #ffeaa7;
            padding: 5px 13px;
            border-radius: 18px;
            font-size: 0.78rem;
            font-weight: 700;
            display: inline-block;
        }

        .actions-cell {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .btn-icon-sm {
            width: 34px;
            height: 34px;
            border: none;
            border-radius: 7px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: 0.3s;
        }

        .btn-edit {
            border: 1px solid #44d264;
            background: #d4edda;
            color: #155724;
        }

            .btn-edit:hover {
                background: #28a745;
                color: white;
            }

        .btn-delete {
            border: 1px solid #937b45;
            background: var(--gold-light);
            color: var(--dark);
        }

            .btn-delete:hover {
                background: var(--gold);
                color: var(--white);
            }

        .btn-more {
            background: var(--dark);
            color: var(--gold);
            border: 2px solid var(--gold);
            padding: 6px 16px;
            border-radius: 25px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.3s;
            font-size: 0.8rem;
            font-family: "Tajawal", sans-serif;
        }

            .btn-more:hover {
                background: var(--gold);
                color: var(--dark);
            }

        .btn {
            padding: 12px 26px;
            border: none;
            border-radius: 10px;
            font-family: "Tajawal", sans-serif;
            font-size: 0.98rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            text-decoration: none;
        }

        .btn-primary {
            background: var(--dark);
            color: #ffffff;
            box-shadow: -1px 2px 9px rgb(11 19 32 / 73%);
        }

            .btn-primary:hover {
                background: #ffffff;
                color: #1a3250;
            }

        /* ===== Empty State ===== */
        .empty-state {
            text-align: center;
            padding: 65px 20px;
            background: var(--bg-light);
            border-radius: 20px;
            border: 2px dashed rgba(26, 27, 71, 0.44);
            transition: all 0.3s ease;
        }

            .empty-state:hover {
                border-color: var(--gold);
                box-shadow: 0 0 30px rgba(212, 175, 55, 0.05);
            }

            .empty-state .empty-icon {
                font-size: 4rem;
                color: var(--gold);
                margin-bottom: 20px;
                opacity: 0.7;
                display: block;
            }

            .empty-state h3 {
                color: var(--dark);
                font-size: 1.5rem;
                margin-bottom: 10px;
                font-weight: 700;
            }

            .empty-state p {
                color: var(--gray);
                font-size: 1rem;
                margin-bottom: 25px;
            }

            .empty-state .btn-primary {
                background: var(--dark);
                color: #ffffff;
                padding: 14px 35px;
                border-radius: 12px;
                font-size: 1rem;
                border: 2px solid var(--gold);
                transition: all 0.3s ease;
                display: inline-flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
                font-family: 'Tajawal', sans-serif;
            }

                .empty-state .btn-primary:hover {
                    background: var(--gold);
                    color: var(--dark);
                    transform: translateY(-3px);
                    box-shadow: 0 10px 30px rgba(212, 175, 55, 0.3);
                }

        .success-msg {
            background: rgba(34, 197, 94, 0.15);
            border: 1px solid #22c55e;
            color: #22c55e;
            padding: 12px 20px;
            border-radius: 10px;
            text-align: center;
            margin-bottom: 20px;
        }

        .custom-notification {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            padding: 15px 30px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 1.1rem;
            z-index: 99999;
            box-shadow: 0 10px 40px rgba(0,0,0,0.3);
            font-family: 'Tajawal', sans-serif;
        }

            .custom-notification.success {
                background: #22c55e;
                color: #fff;
            }

            .custom-notification.error {
                background: #dc3545;
                color: #fff;
            }

        /* ===== مودال الحذف ===== */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(5px);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }

            .modal-overlay.active {
                display: flex !important;
            }

        .modal-card {
            background: linear-gradient(145deg, #ffffff, #f8f6f0);
            border-radius: 28px;
            max-width: 450px;
            width: 90%;
            padding: 40px 35px;
            text-align: center;
            box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(212, 175, 55, 0.3);
            animation: modalFadeIn 0.3s ease;
        }

        @@keyframes modalFadeIn {
            from {
                opacity: 0;
                transform: scale(0.9) translateY(-20px);
            }

            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .modal-card .modal-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--dark), #1a3355);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
            border: 3px solid var(--gold);
            box-shadow: 0 0 30px rgba(212, 175, 55, 0.2);
        }

            .modal-card .modal-icon i {
                font-size: 2.5rem;
                color: var(--gold);
            }

            .modal-card .modal-icon.danger i {
                color: #ff6b6b;
            }

        .modal-card h3 {
            color: var(--dark);
            font-size: 1.6rem;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .modal-card p {
            color: var(--gray);
            font-size: 1.05rem;
            line-height: 1.8;
            margin-bottom: 28px;
        }

        .modal-card .modal-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

            .modal-card .modal-buttons .btn-modal {
                padding: 12px 35px;
                border: none;
                border-radius: 12px;
                font-weight: 700;
                cursor: pointer;
                font-size: 1rem;
                font-family: 'Tajawal', sans-serif;
                transition: all 0.3s ease;
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

            .modal-card .modal-buttons .btn-cancel {
                background: #e8e8ec;
                color: var(--gray);
                border: 2px solid transparent;
            }

                .modal-card .modal-buttons .btn-cancel:hover {
                    background: #d5d5dd;
                    transform: translateY(-2px);
                }

            .modal-card .modal-buttons .btn-confirm-delete {
                background: linear-gradient(135deg, var(--dark), #1a3355);
                color: var(--gold);
                border: 2px solid var(--gold);
            }

                .modal-card .modal-buttons .btn-confirm-delete:hover {
                    background: linear-gradient(135deg, #dc3545, #c82333);
                    color: #ffffff;
                    border-color: #dc3545;
                    transform: translateY(-2px);
                    box-shadow: 0 8px 25px rgba(220, 53, 69, 0.3);
                }

        .modal-card .divider {
            width: 60px;
            height: 3px;
            background: linear-gradient(to left, var(--gold), var(--gold-dark));
            margin: 0 auto 20px;
            border-radius: 2px;
        }

        @@media screen and (max-width: 768px) {
            .navbar {
                flex-direction: column;
                padding: 10px;
            }

                .navbar .nav-links {
                    gap: 15px;
                }

                    .navbar .nav-links a {
                        font-size: 0.8rem;
                    }

            .container {
                padding: 1rem;
            }

            .page-header {
                flex-direction: column;
                text-align: center;
            }

            .page-info {
                flex-direction: column;
                text-align: center;
            }

            .page-title h1 {
                font-size: 1.4rem;
            }

            .card {
                padding: 16px;
            }

            .table-wrap {
                overflow-x: auto;
            }

            .needs-table {
                min-width: 600px;
                font-size: 0.6rem;
                table-layout: fixed;
            }

                .needs-table th,
                .needs-table td {
                    padding: 6px 3px;
                    font-size: 0.55rem;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                    .needs-table th:nth-child(1) {
                        width: 8%;
                    }

                    .needs-table th:nth-child(2) {
                        width: 8%;
                    }

                    .needs-table th:nth-child(3) {
                        width: 10%;
                    }

                    .needs-table th:nth-child(4) {
                        width: 10%;
                    }

                    .needs-table th:nth-child(5) {
                        width: 12%;
                    }

                    .needs-table th:nth-child(6) {
                        width: 8%;
                    }

                    .needs-table th:nth-child(7) {
                        width: 10%;
                    }

                    .needs-table th:nth-child(8) {
                        width: 12%;
                    }

                    .needs-table th:nth-child(9) {
                        width: 22%;
                    }

            .prop-thumb {
                width: 30px;
                height: 30px;
            }

            .btn-icon-sm {
                width: 22px;
                height: 22px;
                font-size: 0.5rem;
            }

            .btn-more {
                padding: 2px 6px;
                font-size: 0.5rem;
                border-width: 1px;
            }

            .badge-sale,
            .status-published,
            .status-pending {
                padding: 2px 4px;
                font-size: 0.45rem;
            }

            .card-header {
                font-size: 0.9rem;
                padding-bottom: 8px;
                margin-bottom: 12px;
            }

                .card-header .icon-circle {
                    width: 30px;
                    height: 30px;
                    font-size: 0.9rem;
                }

            .actions-cell {
                gap: 3px;
            }

            .success-msg {
                font-size: 0.8rem;
                padding: 8px 12px;
            }

            .empty-state {
                padding: 40px 15px;
            }

                .empty-state .empty-icon {
                    font-size: 3rem;
                }

                .empty-state h3 {
                    font-size: 1.2rem;
                }

                .empty-state .btn-primary {
                    padding: 10px 20px;
                    font-size: 0.85rem;
                }

            .modal-card {
                padding: 30px 25px;
            }

                .modal-card .modal-buttons .btn-modal {
                    padding: 10px 25px;
                    font-size: 0.9rem;
                }
        }

        @@media screen and (max-width: 480px) {
            .navbar .nav-links {
                gap: 8px;
            }

                .navbar .nav-links a {
                    font-size: 0.7rem;
                }

            .container {
                padding: 0.5rem;
            }

            .page-header {
                padding: 15px;
            }

            .page-title h1 {
                font-size: 1.2rem;
            }

            .card {
                padding: 12px;
            }

            .needs-table {
                min-width: 450px;
                font-size: 0.5rem;
            }

                .needs-table th,
                .needs-table td {
                    padding: 4px 2px;
                    font-size: 0.45rem;
                }

                    .needs-table th:nth-child(7) {
                        width: 8%;
                    }

                    .needs-table th:nth-child(8) {
                        width: 14%;
                    }

                    .needs-table th:nth-child(9) {
                        width: 26%;
                    }

            .btn-more {
                padding: 2px 4px;
                font-size: 0.4rem;
            }

            .btn-icon-sm {
                width: 18px;
                height: 18px;
                font-size: 0.4rem;
            }

            .prop-thumb {
                width: 25px;
                height: 25px;
            }

            .empty-state {
                padding: 30px 15px;
            }

                .empty-state .empty-icon {
                    font-size: 2.5rem;
                }

                .empty-state h3 {
                    font-size: 1rem;
                }

                .empty-state p {
                    font-size: 0.85rem;
                }

                .empty-state .btn-primary {
                    padding: 8px 16px;
                    font-size: 0.75rem;
                }
        }
    </style>
</head>
<body>

    <!-- ====== نافبار ====== -->
    <nav class="navbar">
        <img class="logo" src="/image/hero.png" alt="SYRELIS" />
        <ul class="nav-links">
            <li><a href="/Home/Index"><span class="link_span">الرئيسية</span></a></li>
            <li><a href="/Properties/Create">أعلن عن عقارك</a></li>
            <li><a href="/Search/Index"><span class="link_span">ابحث عن عقارك</span></a></li>
            <li><a href="/Properties/MyFavorites">حسابي</a></li>
            <li><a href="/Home/Index#contactSection"><span class="link_span">تواصل معنا</span></a></li>
        </ul>
        <div class="navbar-right">
            @if (SignInManager.IsSignedIn(User))
            {
                var userName = User.Identity?.Name ?? "مستخدم";
                var firstLetter = userName.Length > 0 ? userName[0].ToString().ToUpper() : "?";
                <div class="user-avatar">
                    @firstLetter
                    <span class="tooltip">@userName</span>
                </div>
            }
            else
            {
                <button class="login-btn-nav" id="openModalBtn">
                    <i class="fas fa-sign-in-alt" style="margin-left: 6px;"></i> تسجيل الدخول
                </button>
            }
        </div>
    </nav>

    <!-- ====== المحتوى ====== -->
    <div class="container">
        <partial name="_Tabs" />

        <div class="page-header">
            <div class="page-info">
                <a href="/" class="back-button"><i class="fas fa-arrow-right"></i></a>
                <div class="page-title">
                    <h1>عقاراتي</h1>
                    <p>جميع عقاراتك التي نشرتها</p>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <div class="icon-circle"><i class="fa-solid fa-building"></i></div>
                عقاراتي
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="success-msg">
                    <i class="fa-solid fa-check-circle"></i> @TempData["Success"]
                </div>
            }

            @if (Model != null && Model.Any())
            {
                <div class="table-wrap">
                    <table class="needs-table">
                        <thead>
                            <tr>
                                <th>الصورة</th>
                                <th>رقم المحضر</th>
                                <th>تاريخ النشر</th>
                                <th>نوع العقار</th>
                                <th>السعر</th>
                                <th>طبيعة العقار</th>
                                <th>الحالة</th>
                                <th>التفاصيل</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var property in Model)
                            {
                                var mainImage = property.Images?.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? "/image/default.jpg";
                                var propertyNumber = property.Code?.Split('-')?.LastOrDefault() ?? "0";
                                var statusClass = property.IsActive ? "status-published" : "status-pending";
                                var statusText = property.IsActive ? "✓ منشور" : "⏳ قيد المراجعة";

                                <tr>
                                    <td><img src="@mainImage" class="prop-thumb" onerror="this.src='/image/default.jpg'" /></td>
                                    <td>@propertyNumber</td>
                                    <td>@property.CreatedAt.ToString("yyyy/MM/dd")</td>
                                    <td>@(property.PropertyType?.NameAr ?? "-")</td>
                                    <td>@property.Price.ToString("N0") @property.PriceCurrency</td>
                                    <td><span class="badge-sale">@property.Status</span></td>
                                    <td><span class="@statusClass">@statusText</span></td>
                                    <td>
                                        <button class="btn-more" onclick="viewProperty(@property.Id)">تفاصيل</button>
                                    </td>
                                    <td style="text-align:center; vertical-align:middle; padding:14px 8px;">
                                        <div style="display:flex; justify-content:center; align-items:center; gap:8px; flex-wrap:nowrap;">
                                            <a href="/Properties/Edit/@property.Id" class="btn-icon-sm btn-edit" title="تعديل">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                            <button class="btn-icon-sm btn-delete" onclick="deleteProperty(@property.Id)" title="حذف">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <!-- ====== صفحة فارغة منسقة ====== -->
                <div class="empty-state">
                    <span class="empty-icon"><i class="fa-regular fa-building"></i></span>
                    <h3>لا توجد عقارات بعد</h3>
                    <p>قم بإضافة عقارك الأول الآن</p>
                    <a href="/Properties/Create" class="btn-primary">
                        <i class="fa-solid fa-plus"></i> إضافة عقار
                    </a>
                </div>
            }
        </div>
    </div>

    <form id="deleteForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <!-- ====== مودال تأكيد الحذف ====== -->
    <div id="deleteModal" class="modal-overlay">
        <div class="modal-card">
            <div class="modal-icon danger">
                <i class="fa-solid fa-trash-can"></i>
            </div>
            <h3>تأكيد الحذف</h3>
            <div class="divider"></div>
            <p>هل أنت متأكد من حذف هذا العقار؟<br />لا يمكن التراجع عن هذا الإجراء.</p>
            <div class="modal-buttons">
                <button class="btn-modal btn-cancel" onclick="closeDeleteModal()">
                    <i class="fa-solid fa-times"></i> إلغاء
                </button>
                <button class="btn-modal btn-confirm-delete" onclick="confirmDelete()">
                    <i class="fa-solid fa-trash"></i> تأكيد الحذف
                </button>
            </div>
        </div>
    </div>

    <!-- ====== سكربتات ====== -->
    <script>
        var deleteId = 0;

        function deleteProperty(id) {
            deleteId = id;
            document.getElementById('deleteModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('active');
            document.body.style.overflow = '';
            deleteId = 0;
        }

        function confirmDelete() {
            if (deleteId === 0) return;

            var token = document.querySelector('#deleteForm input[name="__RequestVerificationToken"]')?.value;

            fetch('/Properties/Delete/' + deleteId, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || ''
                },
                body: JSON.stringify({ id: deleteId })
            })
            .then(response => response.json())
            .then(data => {
                closeDeleteModal();

                if (data.success) {
                    showNotification('✅ تم حذف العقار بنجاح', 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showNotification('❌ ' + (data.message || 'حدث خطأ أثناء الحذف'), 'error');
                }
            })
            .catch(error => {
                closeDeleteModal();
                showNotification('❌ حدث خطأ أثناء الحذف', 'error');
                console.error(error);
            });
        }

        function showNotification(message, type) {
            var old = document.querySelector('.custom-notification');
            if (old) old.remove();

            var notif = document.createElement('div');
            notif.className = 'custom-notification ' + type;
            notif.textContent = message;
            document.body.appendChild(notif);

            setTimeout(() => {
                notif.style.opacity = '0';
                setTimeout(() => notif.remove(), 500);
            }, 3000);
        }

        function viewProperty(id) {
            window.location.href = '/Properties/Details/' + id;
        }

        // إغلاق المودال عند الضغط على الخلفية
        document.getElementById('deleteModal').addEventListener('click', function(e) {
            if (e.target === this) closeDeleteModal();
        });

        // إغلاق المودال بـ Escape
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (document.getElementById('deleteModal').classList.contains('active')) {
                    closeDeleteModal();
                }
            }
        });
    </script>

</body>
</html>
