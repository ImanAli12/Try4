@model List<RealEstateWebApp.Models.Property>
@{
    ViewData["Title"] = "عقاراتي";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>عقاراتي | SYRELIS</title>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body {
            font-family: 'Tajawal', sans-serif;
            background: #0b1320;
            color: #d4af37;
            padding: 20px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: rgba(255,255,255,0.05);
            border-radius: 20px;
            padding: 30px;
            border: 1px solid rgba(212, 175, 55, 0.2);
        }
        h1 {
            text-align: center;
            font-size: 2rem;
            margin-bottom: 30px;
            color: #d4af37;
        }
        .success-msg {
            background: rgba(34, 197, 94, 0.15);
            border: 1px solid #22c55e;
            color: #22c55e;
            padding: 15px 20px;
            border-radius: 10px;
            text-align: center;
            font-size: 1.1rem;
            margin-bottom: 30px;
        }
        .property-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
        }
        .property-card {
            background: rgba(255,255,255,0.08);
            border-radius: 15px;
            overflow: hidden;
            border: 1px solid rgba(212, 175, 55, 0.15);
            transition: 0.3s;
        }
        .property-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(212, 175, 55, 0.1);
        }
        .property-img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            background: #1a1a2e;
        }
        .property-info {
            padding: 15px;
        }
        .property-info h3 {
            color: #fff;
            font-size: 1.1rem;
            margin-bottom: 8px;
        }
        .property-info .price {
            color: #d4af37;
            font-size: 1.3rem;
            font-weight: 700;
        }
        .property-info .details {
            color: #aaa;
            font-size: 0.9rem;
            margin-top: 5px;
        }
        .property-info .status {
            display: inline-block;
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            margin-top: 8px;
        }
        .status-published {
            background: #22c55e;
            color: #fff;
        }
        .status-pending {
            background: #f59e0b;
            color: #fff;
        }
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #aaa;
        }
        .empty-state i {
            font-size: 4rem;
            color: #d4af37;
            margin-bottom: 20px;
        }
        .btn {
            display: inline-block;
            padding: 10px 25px;
            background: #d4af37;
            color: #0b1320;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 700;
            transition: 0.3s;
            margin-top: 10px;
        }
        .btn:hover {
            background: #f5d45a;
            transform: scale(1.05);
        }
    </style>
</head>
<body>
    <div class="container">
        <h1><i class="fa-solid fa-building"></i> عقاراتي</h1>

        @if (TempData["Success"] != null)
        {
            <div class="success-msg">
                <i class="fa-solid fa-check-circle"></i> @TempData["Success"]
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="property-grid">
                @foreach (var property in Model)
                {
                    var mainImage = property.Images?.FirstOrDefault(i => i.IsMain)?.ImageUrl ?? "/image/default.jpg";
                    <div class="property-card">
                        <img src="@mainImage" alt="@property.Title" class="property-img" />
                        <div class="property-info">
                            <h3>@property.Title</h3>
                            <div class="price">@property.Price.ToString("N0") @property.PriceCurrency</div>
                            <div class="details">
                                <i class="fa-solid fa-location-dot"></i> @property.City?.NameAr
                                <span style="margin:0 8px">|</span>
                                <i class="fa-solid fa-vector-square"></i> @property.Area م²
                            </div>
                            <div class="details">
                                <i class="fa-regular fa-calendar"></i> @property.CreatedAt.ToString("yyyy/MM/dd")
                            </div>
                            <span class="status @(property.IsActive ? "status-published" : "status-pending")">
                                @(property.IsActive ? "✓ منشور" : "⏳ قيد المراجعة")
                            </span>
                            <br />
                            <a href="/Properties/Edit/@property.Id" class="btn" style="background:#0b1320;color:#d4af37;border:1px solid #d4af37;">
                                <i class="fa-solid fa-pen"></i> تعديل
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fa-regular fa-building"></i>
                <h3 style="color:#fff;">لا توجد عقارات بعد</h3>
                <p style="color:#aaa;">قم بإضافة عقارك الأول الآن</p>
                <a href="/Properties/Create" class="btn"><i class="fa-solid fa-plus"></i> إضافة عقار</a>
            </div>
        }
    </div>
</body>
</html>