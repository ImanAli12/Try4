
@model RealEstateWebApp.Models.PropertyViewModel
@using RealEstateWebApp.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@{
    ViewData["Title"] = "تعديل العقار";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تعديل العقار | SYRELIS</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <style>
        :root {
            --dark: #192e43;
            --gold: #d4af37;
            --gray: #51596a;
            --white: #ffffff;
            --gold-light: #f4e5c2;
            --gold-dark: #917005;
            --border: #e8e4dc;
            --bg-light: #f8f9fa;
            --shadow: 0 4px 16px rgba(11, 19, 32, 0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(126deg, rgba(11, 19, 32, 0.85), rgb(11 19 32 / 62%)), url(https://images.unsplash.com/photo-1600585154526-990dced4db0d?q=80&w=2070&auto=format);
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            font-family: 'Tajawal', sans-serif;
            color: var(--gold);
            line-height: 1.6;
            min-height: 100vh;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
        }

        /* ===== Navbar ===== */
        .navbar {
            background: rgba(11, 19, 32, 0.96);
            padding: 0 1rem;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(212, 175, 55, 0.4);
            justify-content: space-between;
            box-shadow: 0px 15px 30px -10px rgb(23, 22, 70);
            position: sticky;
            top: 0;
            z-index: 2000;
            flex-wrap: wrap;
            gap: 10px;
        }

            .navbar .logo {
                width: 82px;
                margin: 8px 0;
                flex-shrink: 0;
            }

            .navbar .nav-links {
                display: flex;
                gap: 30px;
                list-style: none;
                flex-wrap: wrap;
                justify-content: center;
                padding: 0;
                margin: 0;
                align-items: center;
                flex: 1;
            }

                .navbar .nav-links a {
                    color: #f2efea;
                    text-decoration: none;
                    font-weight: 600;
                    font-size: 0.95rem;
                    transition: 0.3s;
                    white-space: nowrap;
                }

                    .navbar .nav-links a:hover {
                        color: #d4af37;
                    }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-right: 3cm;
        }

        .user-avatar {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: linear-gradient(135deg, #d4af37, #b8941f);
            color: #0b1320;
            font-weight: 800;
            font-size: 1.1rem;
            font-family: 'Tajawal', sans-serif;
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid rgba(212, 175, 55, 0.4);
            box-shadow: 0 2px 10px rgba(212, 175, 55, 0.2);
            text-decoration: none;
            user-select: none;
            position: relative;
        }

            .user-avatar:hover {
                transform: scale(1.08);
                box-shadow: 0 4px 20px rgba(212, 175, 55, 0.4);
                border-color: #d4af37;
            }

            .user-avatar .tooltip {
                position: absolute;
                top: 110%;
                left: 50%;
                transform: translateX(-50%);
                background: #0b1320;
                color: #d4af37;
                padding: 6px 14px;
                border-radius: 8px;
                font-size: 0.75rem;
                font-weight: 600;
                white-space: nowrap;
                opacity: 0;
                visibility: hidden;
                transition: all 0.3s ease;
                border: 1px solid rgba(212, 175, 55, 0.2);
                pointer-events: none;
                font-family: 'Tajawal', sans-serif;
            }

            .user-avatar:hover .tooltip {
                opacity: 1;
                visibility: visible;
                top: 120%;
            }

            .user-avatar .tooltip::before {
                content: '';
                position: absolute;
                bottom: 100%;
                left: 50%;
                transform: translateX(-50%);
                border: 6px solid transparent;
                border-bottom-color: #0b1320;
            }

        .login-btn-nav {
            background: transparent;
            border: 1.5px dashed #d4af37;
            color: #d4af37;
            padding: 10px 22px;
            border-radius: 40px;
            font-weight: 700;
            font-size: 0.9rem;
            font-family: 'Tajawal', sans-serif;
            cursor: pointer;
            transition: all 0.3s;
            flex-shrink: 0;
        }

            .login-btn-nav:hover {
                background: #d4af37;
                border: 1px solid rgb(50, 39, 11);
                color: #0b1320;
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
            }

            .login-btn-nav.logout-active {
                color: #d4af37;
                border: 1.5px solid #d4af37;
            }

                .login-btn-nav.logout-active:hover {
                    background: #d4af37;
                    color: #0b1320;
                }

        /* ===== Page Header ===== */
        .page-header {
            padding: 30px 35px;
            margin-bottom: 49px;
            box-shadow: 0 8px 24px rgba(11, 19, 32, 0.15);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 20px;
            width: 100%;
            border-bottom: 2px solid #e2bd46;
        }

        .back-button {
            width: 57px;
            height: 54px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 12px 25px;
            background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
            border: 2px solid var(--white);
            border-radius: 12px;
            color: var(--gold);
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            font-family: "Tajawal", sans-serif;
        }

            .back-button:hover {
                transform: translateX(5px);
                box-shadow: 0 6px 16px rgba(212, 175, 55, 0.5);
            }

        .page-info {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .page-title h1 {
            color: #e2bd46 !important;
            margin: 0;
            font-size: 2rem;
            font-weight: 800;
        }

        .page-title p {
            color: rgba(255, 255, 255, 0.8);
            font-size: 1rem;
            margin: 5px 0 0 0;
        }

        /* ===== Card ===== */
        .card {
            max-width: 100%;
            background: var(--white);
            border-radius: 20px;
            padding: 28px;
            margin-top: 30px;
            margin-bottom: 61px;
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
        }

        .card-header {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--dark);
            margin-bottom: 22px;
            padding-bottom: 14px;
            border-bottom: 2px solid var(--bg-light);
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .card-header .icon-circle {
                width: 40px;
                height: 40px;
                background: #192e43;
                border-radius: 16px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #ffd754;
                font-size: 1.2rem;
            }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

            .form-group.full {
                grid-column: 1 / -1;
            }

            .form-group label {
                font-weight: 500;
                color: var(--dark);
                font-size: 1rem;
            }

                .form-group label .req {
                    font-weight: 800;
                    color: #b20011;
                    font-size: 1.3rem;
                }

        .form-control {
            padding: 12px 15px;
            border: 2px solid var(--border);
            border-radius: 10px;
            font-family: "Tajawal", sans-serif;
            font-size: 0.95rem;
            background: var(--white);
            color: var(--dark);
            transition: all 0.25s;
        }

            .form-control:focus {
                outline: none;
                border-color: #192e43;
                box-shadow: 0 0 0 2px rgb(215 219 232);
            }

        select.form-control {
            appearance: none;
            -webkit-appearance: none;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%23333' stroke-width='2'><polyline points='6 9 12 15 18 9'/></svg>");
            background-repeat: no-repeat;
            background-position: left 12px center;
            padding: 10px 12px 10px 35px;
            background-color: white;
            cursor: pointer;
        }

        .btn {
            padding: 12px 26px;
            border: none;
            border-radius: 10px;
            font-family: "Tajawal", sans-serif;
            font-size: 0.98rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            text-decoration: none;
            transition: 0.3s;
        }

        .btn-primary {
            background: var(--dark);
            color: #ffffff;
            box-shadow: -1px 2px 9px rgb(11 19 32 / 73%);
        }

            .btn-primary:hover {
                background: #ffffff;
                color: #1a3250;
            }

        .btn-secondary {
            border: 1px solid #1a3250;
            background: #1a314d;
            color: #ffffff;
            border-radius: 10px;
            padding: 10px 20px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
        }

            .btn-secondary:hover {
                background: #ffffff;
                color: #1a3250;
            }

        .form-actions {
            display: flex !important;
            justify-content: space-between;
            padding-top: 23px !important;
            flex-wrap: wrap;
            gap: 10px;
        }

        .btn-group {
            display: flex;
            gap: 11px;
        }

        .error-message {
            color: #e5192c;
            font-size: 0.95rem;
            margin-top: 4px;
            display: none;
        }

        .form-control.error {
            border-color: #dc3545 !important;
        }

        /* ===== Map ===== */
        .map-wrapper {
            position: relative;
            width: 100%;
            height: 400px;
            border-radius: 12px;
            overflow: hidden;
            border: 2px solid var(--border);
            background: #e5e7eb;
        }

        #editMap {
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .pegman-marker {
            background: transparent;
            border: none;
        }

        .coords-box {
            display: flex;
            gap: 20px;
            margin-top: 14px;
            flex-wrap: wrap;
            background: #f8f6f0;
            padding: 16px;
            border-radius: 10px;
            border: 1px solid var(--border);
            align-items: flex-end;
        }

            .coords-box .coord-group {
                flex: 1;
                min-width: 150px;
            }

                .coords-box .coord-group label {
                    font-weight: 700;
                    color: var(--dark);
                    font-size: 0.9rem;
                    display: block;
                    margin-bottom: 4px;
                }

                .coords-box .coord-group input {
                    width: 100%;
                    direction: ltr;
                    text-align: center;
                    padding: 10px 12px;
                    border: 2px solid var(--border);
                    border-radius: 10px;
                    font-family: "Tajawal", sans-serif;
                    font-size: 0.95rem;
                    background: var(--white);
                    color: var(--dark);
                    transition: all 0.25s;
                }

                    .coords-box .coord-group input:focus {
                        outline: none;
                        border-color: #192e43;
                        box-shadow: 0 0 0 2px rgb(215 219 232);
                    }

            .coords-box .btn-reset {
                padding: 10px 20px;
                background: var(--dark);
                color: var(--gold);
                border: 2px solid var(--gold);
                border-radius: 10px;
                font-weight: 700;
                cursor: pointer;
                font-family: "Tajawal", sans-serif;
                font-size: 0.9rem;
                transition: all 0.3s ease;
                display: inline-flex;
                align-items: center;
                gap: 7px;
            }

                .coords-box .btn-reset:hover {
                    background: var(--gold);
                    color: var(--dark);
                    transform: translateY(-2px);
                    box-shadow: 0 4px 20px rgba(212, 175, 55, 0.3);
                }

        /* ===== Amenities ===== */
        .amenities-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 11px;
        }

        .amenity-item {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 13px 15px;
            background: var(--bg-light);
            border: 2px solid var(--border);
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            color: var(--dark);
            transition: all 0.3s ease;
        }

            .amenity-item:hover {
                border-color: var(--gold);
                background: var(--gold-light);
            }

            .amenity-item input[type="checkbox"] {
                width: 19px;
                height: 19px;
                accent-color: var(--gold);
                cursor: pointer;
            }

            .amenity-item.checked {
                border-color: var(--gold);
                background: var(--gold-light);
            }

        /* ===== Popups ===== */
        .success-popup,
        .error-popup {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            padding: 18px 35px;
            border-radius: 14px;
            font-weight: 700;
            font-size: 1.15rem;
            z-index: 99999;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
            font-family: 'Tajawal', sans-serif;
            display: flex;
            align-items: center;
            gap: 12px;
            opacity: 1;
            transition: opacity 0.5s ease;
            direction: rtl;
        }

        .success-popup {
            background: #22c55e;
            color: #fff;
        }

            .success-popup i {
                color: #fff;
            }

        .error-popup {
            background: #dc3545;
            color: #fff;
        }

            .error-popup i {
                color: #fff;
            }

        /* ===== Responsive ===== */
        @@media (max-width: 992px) {
            .navbar .nav-links {
                gap: 25px;
            }

            .navbar-right {
                margin-right: 1cm;
            }
        }

        @@media (max-width: 768px) {
            .navbar {
                flex-direction: column;
                padding: 10px;
            }

                .navbar .logo {
                    width: 50px;
                }

                .navbar .nav-links {
                    gap: 12px;
                }

                    .navbar .nav-links a {
                        font-size: 0.8rem;
                    }

            .container {
                padding: 1rem;
            }

            .page-header {
                flex-direction: column;
                text-align: center;
                padding: 20px;
            }

            .page-info {
                flex-direction: column;
                text-align: center;
            }

            .page-title h1 {
                font-size: 1.4rem;
            }

            .card {
                padding: 16px;
            }

            .form-grid {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .form-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .btn-group {
                justify-content: center;
            }

            .btn {
                padding: 10px 18px;
                font-size: 0.9rem;
                justify-content: center;
            }

            .amenities-grid {
                grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
                gap: 8px;
            }

            .amenity-item {
                padding: 10px 12px;
                font-size: 0.8rem;
            }

            .map-wrapper {
                height: 300px;
            }

            .coords-box {
                flex-direction: column;
                align-items: stretch;
            }

                .coords-box .btn-reset {
                    justify-content: center;
                }

            .navbar-right {
                margin-right: 1cm;
            }

            .success-popup,
            .error-popup {
                padding: 14px 20px;
                font-size: 0.95rem;
                width: 90%;
                text-align: center;
                justify-content: center;
            }
        }

        @@media (max-width: 480px) {
            .navbar .nav-links {
                gap: 8px;
            }

                .navbar .nav-links a {
                    font-size: 0.7rem;
                }

            .container {
                padding: 0.5rem;
            }

            .page-header {
                padding: 15px;
            }

            .page-title h1 {
                font-size: 1.2rem;
            }

            .card {
                padding: 12px;
            }

            .form-control {
                padding: 8px 10px;
                font-size: 0.8rem;
            }

            .form-group label {
                font-size: 0.85rem;
            }

            .btn {
                padding: 8px 14px;
                font-size: 0.8rem;
            }

            .amenities-grid {
                grid-template-columns: 1fr 1fr;
                gap: 6px;
            }

            .amenity-item {
                padding: 8px 10px;
                font-size: 0.7rem;
            }

            .map-wrapper {
                height: 250px;
            }

            .coords-box .coord-group {
                min-width: 100px;
            }

            .navbar-right {
                margin-right: 0.5cm;
            }

            .success-popup,
            .error-popup {
                padding: 12px 16px;
                font-size: 0.85rem;
            }
        }
    </style>
</head>
<body>

    <!-- ====== نافبار ====== -->
    <nav class="navbar">
        <img class="logo" src="/image/hero.png" alt="SYRELIS" />
        <ul class="nav-links">
            <li><a href="/Home/Index"><span class="link_span">الرئيسية</span></a></li>
            <li><a href="/Properties/Create">أعلن عن عقارك</a></li>
            <li><a href="/Search/Index"><span class="link_span">ابحث عن عقارك</span></a></li>
            <li><a href="/Properties/MyFavorites">حسابي</a></li>
            <li><a href="/Home/Index#contactSection"><span class="link_span">تواصل معنا</span></a></li>
        </ul>
        <div class="navbar-right">
            @if (SignInManager.IsSignedIn(User))
            {
                var userName = User.Identity?.Name ?? "مستخدم";
                var firstLetter = userName.Length > 0 ? userName[0].ToString().ToUpper() : "?";
                <div class="user-avatar">
                    @firstLetter
                    <span class="tooltip">@userName</span>
                </div>
            }
            else
            {
                <button class="login-btn-nav" id="openModalBtn">
                    <i class="fas fa-sign-in-alt" style="margin-left: 6px;"></i> تسجيل الدخول
                </button>
            }
        </div>
    </nav>

    <!-- ====== المحتوى ====== -->
    <div class="container">

        <!-- ====== Page Header ====== -->
        <div class="page-header">
            <div class="page-info">
                <a href="/Properties/MyProperties" class="back-button">
                    <i class="fas fa-arrow-right"></i>
                </a>
                <div class="page-title">
                    <h1>تعديل العقار</h1>
                    <p>قم بتحديث بيانات عقارك</p>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <div class="icon-circle"><i class="fa-solid fa-pen"></i></div>
                تعديل العقار
            </div>

            @if (TempData["Success"] != null)
            {
                <div id="successPopup" class="success-popup">
                    <i class="fa-solid fa-circle-check"></i>
                    @TempData["Success"]
                </div>
                <script>
                    setTimeout(function() {
                        var popup = document.getElementById('successPopup');
                        if (popup) {
                            popup.style.opacity = '0';
                            setTimeout(function() { popup.remove(); }, 500);
                        }
                    }, 3500);
                </script>
            }

            @if (TempData["Error"] != null)
            {
                <div id="errorPopup" class="error-popup">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    @TempData["Error"]
                </div>
                <script>
                    setTimeout(function() {
                        var popup = document.getElementById('errorPopup');
                        if (popup) {
                            popup.style.opacity = '0';
                            setTimeout(function() { popup.remove(); }, 500);
                        }
                    }, 4000);
                </script>
            }

            <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="PropertyNumber" />

                <div class="form-grid">
                    <!-- نوع العقار -->
                    <div class="form-group">
                        <label>نوع العقار <span class="req">*</span></label>
                        <select asp-for="PropertyTypeId" class="form-control" required>
                            <option value="">اختر النوع</option>
                            @foreach (var type in Model.PropertyTypes)
                            {
                                <option value="@type.Id">@type.NameAr</option>
                            }
                        </select>
                        <span asp-validation-for="PropertyTypeId" class="error-message"></span>
                    </div>

                    <!-- طبيعة العقار -->
                    <div class="form-group">
                        <label>طبيعة العقار <span class="req">*</span></label>
                        <select asp-for="Status" class="form-control" required>
                            <option value="للبيع">للبيع</option>
                        </select>
                        <span asp-validation-for="Status" class="error-message"></span>
                    </div>

                    <!-- السعر -->
                    <div class="form-group">
                        <label>السعر <span class="req">*</span></label>
                        <input asp-for="Price" type="number" class="form-control" placeholder="أدخل السعر" required min="0" />
                        <span asp-validation-for="Price" class="error-message"></span>
                    </div>

                    <!-- العملة -->
                    <div class="form-group">
                        <label>العملة <span class="req">*</span></label>
                        <select asp-for="PriceCurrency" class="form-control" required>
                            <option value="USD">دولار أمريكي</option>
                            <option value="SYP">ليرة سورية</option>
                        </select>
                        <span asp-validation-for="PriceCurrency" class="error-message"></span>
                    </div>

                    <!-- العنوان -->
                    <div class="form-group full">
                        <label>عنوان العقار <span class="req">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="اكتب عنواناً مناسباً للعقار..." required />
                        <span asp-validation-for="Title" class="error-message"></span>
                    </div>

                    <!-- الوصف -->
                    <div class="form-group full">
                        <label>الوصف المفصل</label>
                        <textarea asp-for="Description" class="form-control" placeholder="اكتب وصفاً مفصلاً للعقار..." rows="4"></textarea>
                    </div>

                    <!-- المدينة -->
                    <div class="form-group">
                        <label>المدينة <span class="req">*</span></label>
                        <select asp-for="CityId" class="form-control" required>
                            <option value="">اختر المدينة</option>
                            @foreach (var city in Model.Cities)
                            {
                                <option value="@city.Id">@city.NameAr</option>
                            }
                        </select>
                        <span asp-validation-for="CityId" class="error-message"></span>
                    </div>

                    <!-- الحي -->
                    <div class="form-group">
                        <label>الحي <span class="req">*</span></label>
                        <input asp-for="Neighborhood" class="form-control" placeholder="اسم الحي" required />
                        <span asp-validation-for="Neighborhood" class="error-message"></span>
                    </div>

                    <!-- الشارع -->
                    <div class="form-group full">
                        <label>الشارع</label>
                        <input asp-for="Address" class="form-control" placeholder="اسم الشارع" />
                    </div>

                    <!-- الموقع التفصيلي -->
                    <div class="form-group full">
                        <label>الموقع التفصيلي <span class="req">*</span></label>
                        <textarea asp-for="DetailedLocation" class="form-control" placeholder="أدخل موقع العقار بالتفصيل..." required></textarea>
                        <span asp-validation-for="DetailedLocation" class="error-message"></span>
                    </div>

                    <!-- المساحة -->
                    <div class="form-group">
                        <label>المساحة (م²) <span class="req">*</span></label>
                        <input asp-for="Area" type="number" class="form-control" placeholder="المساحة" required min="1" />
                        <span asp-validation-for="Area" class="error-message"></span>
                    </div>

                    <!-- عدد الغرف -->
                    <div class="form-group">
                        <label>عدد الغرف</label>
                        <input asp-for="Rooms" type="number" class="form-control" placeholder="الغرف" min="0" />
                    </div>

                    <!-- عدد الحمامات -->
                    <div class="form-group">
                        <label>عدد الحمامات</label>
                        <input asp-for="Bathrooms" type="number" class="form-control" placeholder="الحمامات" min="0" />
                    </div>

                    <!-- رقم الطابق -->
                    <div class="form-group">
                        <label>رقم الطابق</label>
                        <input asp-for="Floor" type="number" class="form-control" placeholder="رقم الطابق" min="-2" />
                    </div>

                    <!-- متاح من -->
                    <div class="form-group">
                        <label>متاح من تاريخ <span class="req">*</span></label>
                        <input asp-for="AvailableFrom" type="date" class="form-control" required />
                        <span asp-validation-for="AvailableFrom" class="error-message"></span>
                    </div>

                    <!-- رقم الاتصال -->
                    <div class="form-group">
                        <label>رقم الاتصال <span class="req">*</span></label>
                        <input asp-for="AdvertiserPhone" type="tel" class="form-control" placeholder="09XXXXXXXX" required maxlength="10" />
                        <span asp-validation-for="AdvertiserPhone" class="error-message"></span>
                    </div>

                    <!-- المرافق -->
                    <div class="form-group full">
                        <label>المرافق</label>
                        <div class="amenities-grid">
                            @foreach (var feature in Model.Features)
                            {
                                <label class="amenity-item @(Model.FeatureIds.Contains(feature.Id) ? "checked" : "")">
                                    <input type="checkbox" name="FeatureIds" value="@feature.Id" @(Model.FeatureIds.Contains(feature.Id) ? "checked" : "") onchange="this.parentElement.classList.toggle('checked')" />
                                    <i class="fa-solid @(feature.IconClass ?? "fa-check")"></i> @feature.NameAr
                                </label>
                            }
                        </div>
                    </div>

                    <!-- ====== الموقع على الخريطة ====== -->
                    <div class="form-group full">
                        <label>تحديد الموقع على الخريطة <span class="req">*</span></label>
                        <p style="font-size:0.85rem; color:var(--gray); margin-bottom:10px;">
                            <i class="fa-solid fa-location-dot" style="color:var(--gold);"></i> اسحب الرجل الأصفر لتحديد الموقع
                        </p>
                        <div class="map-wrapper" id="editMapWrapper">
                            <div id="editMap"></div>
                        </div>

                        <div class="coords-box">
                            <div class="coord-group">
                                <label><i class="fa-solid fa-location-dot" style="color:var(--gold);"></i> خط العرض</label>
                                <input type="text" id="editLatDisplay" value="@Model.Latitude?.ToString("F6")" />
                            </div>
                            <div class="coord-group">
                                <label><i class="fa-solid fa-location-dot" style="color:var(--gold);"></i> خط الطول</label>
                                <input type="text" id="editLngDisplay" value="@Model.Longitude?.ToString("F6")" />
                            </div>
                            <div>
                                <button type="button" class="btn-reset" onclick="resetEditLocation()">
                                    <i class="fa-solid fa-rotate-right"></i> إعادة تعيين
                                </button>
                            </div>
                        </div>

                        <input type="hidden" asp-for="Latitude" id="editLat" />
                        <input type="hidden" asp-for="Longitude" id="editLng" />
                    </div>
                </div>

                <!-- ====== أزرار ====== -->
                <div class="form-actions">
                    <div class="btn-group">
                        <a href="/Properties/MyProperties" class="btn btn-secondary">
                            <i class="fa-solid fa-arrow-right"></i> العودة
                        </a>
                    </div>
                    <div class="btn-group">
                        <button type="submit" class="btn btn-primary" id="saveBtn">
                            <i class="fa-solid fa-save"></i> حفظ التغييرات
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // ====== متغيرات الخريطة ======
        var editMap, editMarker;
        var defaultLat = @Model.Latitude?.ToString("F6") ?? 33.5138;
        var defaultLng = @Model.Longitude?.ToString("F6") ?? 36.2765;

        // ====== تهيئة الخريطة ======
        function initEditMap() {
            if (editMap) {
                editMap.remove();
                editMap = null;
            }

            var mapContainer = document.getElementById('editMap');
            if (!mapContainer) return;

            editMap = L.map('editMap', {
                zoomControl: true,
                dragging: true,
                minZoom: 8,
                maxZoom: 19
            }).setView([defaultLat, defaultLng], 15);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '© OpenStreetMap'
            }).addTo(editMap);

            var pegmanSVG = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 23 38" width="44" height="44">
                <path d="M16.6 38.1h-5.5l-.2-2.9-.2 2.9H5.2L5 25.3l-.8 2a1.53 1.53 0 01-1.9.9l-1.2-.4a1.58 1.58 0 01-1-1.9v-.1c.3-.9 3.1-11.2 3.1-11.2a2.66 2.66 0 012.3-2l.6-.5a6.93 6.93 0 014.7-12 6.8 6.8 0 014.9 2 7 7 0 012 4.9 6.65 6.65 0 01-2.2 5l.7.5a2.78 2.78 0 012.4 2s2.9 11.2 2.9 11.3a1.53 1.53 0 01-.9 1.9l-1.3.4a1.63 1.63 0 01-1.9-.9l-.7-1.8z" fill="#333" opacity=".7"/>
                <path d="m5.9 13.6 1.1-.9h7.8l1.2.9" fill="#ce592c"/>
                <ellipse cx="10.9" cy="13.1" rx="2.7" ry=".3" fill="#ce592c" opacity=".5"/>
                <path d="m20.6 26.1-2.9-11.3a1.71 1.71 0 00-1.6-1.2H5.7a1.69 1.69 0 00-1.5 1.3L1.1 26.2a.61.61 0 00.3.7l1.1.4a.61.61 0 00.7-.3l2.7-6.7.2 16.8h3.6l.6-9.3a.47.47 0 01.44-.5h.06c.4 0 .4.2.5.5l.6 9.3h3.6l.2-16.8 2.5 6.6a.52.52 0 00.66.31l1.2-.4a.57.57 0 00.5-.7Z" fill="#fdbf2d"/>
                <circle cx="10.9" cy="7" r="5.9" fill="#fdbf2d"/>
            </svg>`;

            var pegmanIcon = L.divIcon({
                className: 'pegman-marker',
                html: pegmanSVG,
                iconSize: [44, 44],
                iconAnchor: [22, 42]
            });

            editMarker = L.marker([defaultLat, defaultLng], {
                icon: pegmanIcon,
                draggable: true
            }).addTo(editMap);

            editMarker.on('dragend', function(e) {
                var pos = e.target.getLatLng();
                updateEditCoords(pos.lat, pos.lng);
            });

            editMap.on('click', function(e) {
                var pos = e.latlng;
                if (editMarker) {
                    editMap.removeLayer(editMarker);
                }
                editMarker = L.marker([pos.lat, pos.lng], {
                    icon: pegmanIcon,
                    draggable: true
                }).addTo(editMap);
                updateEditCoords(pos.lat, pos.lng);
                editMarker.on('dragend', function(ev) {
                    var newPos = ev.target.getLatLng();
                    updateEditCoords(newPos.lat, newPos.lng);
                });
            });

            setTimeout(function() {
                editMap.invalidateSize();
            }, 500);
        }

        // ====== تحديث الإحداثيات ======
        function updateEditCoords(lat, lng) {
            document.getElementById('editLatDisplay').value = lat.toFixed(6);
            document.getElementById('editLngDisplay').value = lng.toFixed(6);
            document.getElementById('editLat').value = lat;
            document.getElementById('editLng').value = lng;
        }

        // ====== إعادة تعيين الموقع ======
        function resetEditLocation() {
            if (editMarker && editMap) {
                editMap.removeLayer(editMarker);
            }
            var pegmanSVG = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 23 38" width="44" height="44">
                <path d="M16.6 38.1h-5.5l-.2-2.9-.2 2.9H5.2L5 25.3l-.8 2a1.53 1.53 0 01-1.9.9l-1.2-.4a1.58 1.58 0 01-1-1.9v-.1c.3-.9 3.1-11.2 3.1-11.2a2.66 2.66 0 012.3-2l.6-.5a6.93 6.93 0 014.7-12 6.8 6.8 0 014.9 2 7 7 0 012 4.9 6.65 6.65 0 01-2.2 5l.7.5a2.78 2.78 0 012.4 2s2.9 11.2 2.9 11.3a1.53 1.53 0 01-.9 1.9l-1.3.4a1.63 1.63 0 01-1.9-.9l-.7-1.8z" fill="#333" opacity=".7"/>
                <path d="m5.9 13.6 1.1-.9h7.8l1.2.9" fill="#ce592c"/>
                <ellipse cx="10.9" cy="13.1" rx="2.7" ry=".3" fill="#ce592c" opacity=".5"/>
                <path d="m20.6 26.1-2.9-11.3a1.71 1.71 0 00-1.6-1.2H5.7a1.69 1.69 0 00-1.5 1.3L1.1 26.2a.61.61 0 00.3.7l1.1.4a.61.61 0 00.7-.3l2.7-6.7.2 16.8h3.6l.6-9.3a.47.47 0 01.44-.5h.06c.4 0 .4.2.5.5l.6 9.3h3.6l.2-16.8 2.5 6.6a.52.52 0 00.66.31l1.2-.4a.57.57 0 00.5-.7Z" fill="#fdbf2d"/>
                <circle cx="10.9" cy="7" r="5.9" fill="#fdbf2d"/>
            </svg>`;

            var pegmanIcon = L.divIcon({
                className: 'pegman-marker',
                html: pegmanSVG,
                iconSize: [44, 44],
                iconAnchor: [22, 42]
            });

            var center = editMap.getCenter();
            editMarker = L.marker([center.lat, center.lng], {
                icon: pegmanIcon,
                draggable: true
            }).addTo(editMap);
            updateEditCoords(center.lat, center.lng);
            editMarker.on('dragend', function(e) {
                var pos = e.target.getLatLng();
                updateEditCoords(pos.lat, pos.lng);
            });
        }

        // ====== تشغيل الخريطة عند تحميل الصفحة ======
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(initEditMap, 500);
        });

        // ====== التحقق من صحة النموذج ======
        document.getElementById('editForm').addEventListener('submit', function(e) {
            var required = this.querySelectorAll('[required]');
            var isValid = true;

            required.forEach(function(field) {
                if (!field.value || field.value === '') {
                    field.classList.add('error');
                    var errorDiv = field.parentElement.querySelector('.error-message');
                    if (errorDiv) errorDiv.style.display = 'block';
                    isValid = false;
                } else {
                    field.classList.remove('error');
                    var errorDiv = field.parentElement.querySelector('.error-message');
                    if (errorDiv) errorDiv.style.display = 'none';
                }
            });

            if (!isValid) {
                e.preventDefault();
                var errorPopup = document.createElement('div');
                errorPopup.className = 'error-popup';
                errorPopup.innerHTML = '<i class="fa-solid fa-circle-exclamation"></i> ⚠️ الرجاء تعبئة جميع الحقول المطلوبة';
                document.body.appendChild(errorPopup);
                setTimeout(function() {
                    errorPopup.style.opacity = '0';
                    setTimeout(function() { errorPopup.remove(); }, 500);
                }, 3000);
            }
        });

        // ====== تفعيل وإلغاء تفعيل المرافق ======
        document.querySelectorAll('.amenity-item input[type="checkbox"]').forEach(function(cb) {
            cb.addEventListener('change', function() {
                this.parentElement.classList.toggle('checked');
            });
        });
    </script>

</body>
</html>
